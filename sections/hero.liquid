{%- comment -%} sync: rev2 {%- endcomment -%}
<section class="hero {% unless section.settings.image %}hero--placeholder{% endunless %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {% assign hero_alt = section.settings.heading | escape %}
      {{ section.settings.image | image_url: width: 2000 | image_tag: alt: hero_alt, fetchpriority: 'high', sizes: '100vw', widths: '750, 1100, 1500, 2000' }}
    </div>
  {%- elsif section.settings.image_url != blank -%}
    <div class="hero__media"><img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}"></div>
  {%- endif -%}
  <div class="hero__overlay"></div>

  <div class="page-width hero__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>
      {{ section.settings.heading }}
      {%- if section.settings.heading_emphasis != blank -%}<br><em>{{ section.settings.heading_emphasis }}</em>{%- endif -%}
    </h1>
    {%- if section.settings.subtext != blank -%}<p class="hero__sub">{{ section.settings.subtext }}</p>{%- endif -%}

    {%- if section.blocks.size > 0 -%}
      <div class="hero__perks">
        {%- for block in section.blocks -%}
          <span class="perk" {{ block.shopify_attributes }}>{% render 'icon', icon: 'check-circle' %}{{ block.settings.text }}</span>
        {%- endfor -%}
      </div>
    {%- endif -%}

    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link | default: routes.all_products_collection_url }}" class="btn btn--accent btn--lg btn--pill">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 }}" class="btn btn--outline-light btn--lg btn--pill">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_url", "label": "Background image URL (fallback)", "default": "https://images.unsplash.com/photo-1464822759023-fed622ff2c3b?w=1920&auto=format&fit=crop" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Ty-Leigh Capital Land Co." },
    { "type": "text", "id": "heading", "label": "Heading line 1", "default": "Own Land." },
    { "type": "text", "id": "heading_emphasis", "label": "Heading line 2 (accent)", "default": "Start Today." },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Affordable vacant land across the US with flexible owner financing. No credit check. No hassle." },
    { "type": "text", "id": "button_label", "label": "Primary button label", "default": "Browse Available Properties" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button label", "default": "View on Map" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" }
  ],
  "blocks": [
    {
      "type": "perk",
      "name": "Perk",
      "settings": [
        { "type": "text", "id": "text", "label": "Text", "default": "No Credit Check Required" }
      ]
    }
  ],
  "max_blocks": 5,
  "presets": [
    {
      "name": "Hero",
      "blocks": [
        { "type": "perk", "settings": { "text": "No Credit Check Required" } },
        { "type": "perk", "settings": { "text": "Starting at $99/mo" } },
        { "type": "perk", "settings": { "text": "60-Day Money-Back Guarantee" } },
        { "type": "perk", "settings": { "text": "Owner Financing Available" } }
      ]
    }
  ]
}
{% endschema %}
