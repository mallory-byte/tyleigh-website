<div class="page-width section">
  {%- if section.settings.heading != blank -%}
    <div class="section-head section-head--center">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="feature-grid">
    {%- for block in section.blocks -%}
      <div class="feature-card" {{ block.shopify_attributes }}>
        <span class="feature-card__icon">{% render 'icon', icon: block.settings.icon %}</span>
        <h3>{{ block.settings.title }}</h3>
        <p>{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Value props",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Why Tyleigh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Land ownership without the headaches" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "We handle the diligence so you can buy with clarity and confidence." }
  ],
  "blocks": [
    {
      "type": "prop",
      "name": "Value prop",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "shield",
          "options": [
            { "value": "shield", "label": "Shield" },
            { "value": "doc", "label": "Document" },
            { "value": "tag", "label": "Tag / price" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "road", "label": "Road" },
            { "value": "tree", "label": "Tree" },
            { "value": "check", "label": "Check" },
            { "value": "clock", "label": "Clock" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Clear, verified title" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Every parcel is title-checked before it lists. You get a clean deed, recorded in your name." }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Value props",
      "blocks": [
        { "type": "prop", "settings": { "icon": "shield", "title": "Clear, verified title", "text": "Every parcel is title-checked before it lists. You get a clean deed, recorded in your name." } },
        { "type": "prop", "settings": { "icon": "tag", "title": "Transparent pricing", "text": "The price you see is the price you pay. No hidden fees, no auctions, no surprises." } },
        { "type": "prop", "settings": { "icon": "doc", "title": "Simple owner financing", "text": "Skip the bank. Put money down and pay monthly with straightforward, flexible terms." } },
        { "type": "prop", "settings": { "icon": "map-pin", "title": "Land you can actually use", "text": "Detailed specs on access, zoning, and utilities so you know exactly what you're buying." } }
      ]
    }
  ]
}
{% endschema %}
