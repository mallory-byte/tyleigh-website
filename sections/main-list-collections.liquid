<div class="page-width section">
  <div class="section-head section-head--center">
    <span class="eyebrow">Browse by region</span>
    <h1>{{ page_title }}</h1>
    <p>Explore our land collections. Group parcels by state, price range, or property type.</p>
  </div>

  <div class="product-grid product-grid--4">
    {%- for collection in collections -%}
      {%- if collection.handle != 'frontpage' -%}
        <a href="{{ collection.url }}" class="parcel-card">
          <div class="parcel-card__media">
            {%- if collection.image -%}
              {{ collection.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title | escape }}
            {%- elsif collection.products.first.featured_media -%}
              {{ collection.products.first.featured_media | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title | escape }}
            {%- else -%}
              <div style="display:grid;place-items:center;height:100%;color:var(--color-muted)">{% render 'icon', icon: 'tree' %}</div>
            {%- endif -%}
          </div>
          <div class="parcel-card__body">
            <h3 class="parcel-card__title">{{ collection.title }}</h3>
            <p class="text-muted mb-0">{{ collection.all_products_count }} parcels</p>
          </div>
        </a>
      {%- endif -%}
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "List collections",
  "settings": []
}
{% endschema %}
