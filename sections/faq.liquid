<div class="page-width section">
  <div class="section-head section-head--center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  <div class="faq">
    {%- for block in section.blocks -%}
      <details class="faq-item" {{ block.shopify_attributes }}>
        <summary>{{ block.settings.question }}</summary>
        <div class="faq-item__body rte">{{ block.settings.answer }}</div>
      </details>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Questions" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently asked questions" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "question", "label": "Question", "default": "How does owner financing work?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>You make a down payment and pay the balance in fixed monthly installments. There's no bank, no credit check, and no prepayment penalty.</p>" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [
    {
      "name": "FAQ",
      "blocks": [
        { "type": "qa", "settings": { "question": "How does owner financing work?", "answer": "<p>You make a down payment and pay the balance in fixed monthly installments. There's no bank, no credit check, and no prepayment penalty.</p>" } },
        { "type": "qa", "settings": { "question": "Do I get a real deed?", "answer": "<p>Yes. Once the parcel is paid in full (or at closing for cash purchases), a deed is recorded in your name with the county.</p>" } },
        { "type": "qa", "settings": { "question": "Can I visit the land before buying?", "answer": "<p>Absolutely. We provide GPS coordinates and parcel maps so you can walk the property. Reach out and we'll help you plan a visit.</p>" } },
        { "type": "qa", "settings": { "question": "What can I do with the land?", "answer": "<p>It depends on the parcel's zoning, which we list on every listing. Common uses include recreation, camping, building, and long-term investment.</p>" } }
      ]
    }
  ]
}
{% endschema %}
