<div class="page-width section">
  <div class="newsletter">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="text-muted">{{ section.settings.subtext }}</p>{%- endif -%}

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter, land-alerts">
      {%- if form.posted_successfully? -%}
        <div class="form-note form-note--success">{{ 'general.newsletter.success' | t }}</div>
      {%- else -%}
        <div class="search-form">
          <label class="search-form__field">
            <span class="visually-hidden">{{ 'general.newsletter.label' | t }}</span>
            {% render 'icon', icon: 'mail' %}
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
          </label>
          <button type="submit" class="btn btn--primary">{{ 'general.newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Stay in the loop" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New parcels, in your inbox" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Get an email the moment new land lists. No spam — just parcels." }
  ],
  "presets": [
    { "name": "Newsletter" }
  ]
}
{% endschema %}
