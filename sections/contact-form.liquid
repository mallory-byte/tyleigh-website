<div class="page-width section">
  <div class="section-head section-head--center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ page.title | default: section.settings.heading }}</h1>
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  <div style="max-width:40rem;margin-inline:auto">
    {%- if page.content != blank -%}
      <div class="rte" style="margin-bottom:var(--space-6)">{{ page.content }}</div>
    {%- endif -%}

    {%- form 'contact', id: 'ContactForm' -%}
      {%- if form.posted_successfully? -%}
        <div class="form-note form-note--success">{{ 'contact.form.success' | t }}</div>
      {%- elsif form.errors -%}
        <div class="form-note form-note--error">{{ form.errors | default_errors }}</div>
      {%- endif -%}

      <div class="form-grid">
        <div class="form-field">
          <label for="ContactName">{{ 'contact.form.name' | t }}</label>
          <input type="text" id="ContactName" name="contact[name]" value="{{ form.name }}" required>
        </div>
        <div class="form-field">
          <label for="ContactEmail">{{ 'contact.form.email' | t }}</label>
          <input type="email" id="ContactEmail" name="contact[email]" value="{{ form.email }}" required autocomplete="email">
        </div>
      </div>
      <div class="form-grid">
        <div class="form-field">
          <label for="ContactPhone">{{ 'contact.form.phone' | t }}</label>
          <input type="tel" id="ContactPhone" name="contact[phone]" value="{{ form.phone }}" autocomplete="tel">
        </div>
        <div class="form-field">
          <label for="ContactParcel">{{ 'contact.form.parcel' | t }}</label>
          <input type="text" id="ContactParcel" name="contact[Parcel of interest]" data-parcel-field>
        </div>
      </div>
      <div class="form-field">
        <label for="ContactMessage">{{ 'contact.form.message' | t }}</label>
        <textarea id="ContactMessage" name="contact[body]" required>{{ form.body }}</textarea>
      </div>
      <button type="submit" class="btn btn--primary btn--lg">{{ 'contact.form.send' | t }}</button>
    {%- endform -%}
  </div>
</div>

<script>
  (function () {
    var params = new URLSearchParams(window.location.search);
    var parcel = params.get('parcel');
    if (parcel) {
      var field = document.querySelector('[data-parcel-field]');
      if (field) field.value = parcel;
    }
  })();
</script>

{% schema %}
{
  "name": "Contact form",
  "settings": [
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Contact"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading (used if page has no title)",
      "default": "Talk to our land team"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Questions about a parcel, financing, or the buying process? Send us a note and we'll respond within one business day."
    }
  ]
}
{% endschema %}
