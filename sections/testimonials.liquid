<div class="page-width section">
  <div class="section-head section-head--center">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="testimonials">
    {%- for block in section.blocks -%}
      <figure class="testimonial" {{ block.shopify_attributes }}>
        <blockquote class="testimonial__quote">"{{ block.settings.quote }}"</blockquote>
        <figcaption>
          <div class="testimonial__author">{{ block.settings.author }}</div>
          {%- if block.settings.detail != blank -%}<div class="testimonial__meta">{{ block.settings.detail }}</div>{%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buyers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Land owners who started here" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The whole process was transparent and quick. I had the deed to my 5 acres in a few weeks." },
        { "type": "text", "id": "author", "label": "Author", "default": "Dana R." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Costilla County, CO" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    {
      "name": "Testimonials",
      "blocks": [
        { "type": "quote" },
        { "type": "quote", "settings": { "quote": "Owner financing made it possible for us to buy land we'd otherwise have to save years for.", "author": "Marcus & Lena T.", "detail": "Apache County, AZ" } },
        { "type": "quote", "settings": { "quote": "Every detail on the listing was accurate. No surprises when I walked the parcel.", "author": "Priya S.", "detail": "Elko County, NV" } }
      ]
    }
  ]
}
{% endschema %}
