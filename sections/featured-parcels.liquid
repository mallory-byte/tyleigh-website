{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 4
-%}
<div class="page-width section">
  <div class="collection-toolbar" style="align-items:flex-end">
    <div class="section-head" style="margin-bottom:0">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2 class="mb-0">{{ section.settings.heading }}</h2>
    </div>
    {%- if coll and coll.url -%}
      <a href="{{ coll.url }}" class="btn btn--ghost">View all {% render 'icon', icon: 'arrow-right' %}</a>
    {%- endif -%}
  </div>

  {%- if coll and coll.products.size > 0 -%}
    <div class="product-grid product-grid--4" style="margin-top:var(--space-5)">
      {%- for product in coll.products limit: limit -%}
        {% render 'parcel-card', product: product %}
      {%- endfor -%}
    </div>
  {%- else -%}
    <div class="empty-state">
      <p class="text-muted">Select a collection in the theme editor to feature parcels here.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Featured parcels",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Featured land" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Newly listed parcels" },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 2, "max": 8, "step": 1, "label": "Parcels to show", "default": 4 }
  ],
  "presets": [
    { "name": "Featured parcels" }
  ]
}
{% endschema %}
