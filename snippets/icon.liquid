  {%- when 'tree' -%}
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 22v-7M9 9a3 3 0 0 1 3-6 3 3 0 0 1 3 6 3 3 0 0 1 2 5H7a3 3 0 0 1 2-5z"/></svg>
