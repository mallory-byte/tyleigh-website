{%- comment -%}
  Storefront filtering sidebar. Renders whatever filters are configured in
  Shopify Admin → Search & discovery (recommended: State, Acreage, Price,
  Financing available). Works for both collection and search results.
  Params: results (collection or search), enable_filtering (bool)
{%- endcomment -%}
{%- liquid
  assign filters = results.filters
  assign sort_by = results.sort_by | default: results.default_sort_by
-%}
{%- if filters != empty -%}
  <aside class="facets" data-facets aria-expanded="false">
    <div class="facets__panel">
      <form method="get" data-auto-submit>
        {%- comment -%} Preserve keyword search query on search page {%- endcomment -%}
        {%- if results.terms -%}
          <input type="hidden" name="q" value="{{ results.terms | escape }}">
          <input type="hidden" name="type" value="product">
        {%- endif -%}
        {%- if sort_by != blank -%}
          <input type="hidden" name="sort_by" value="{{ sort_by }}">
        {%- endif -%}

        <div class="facets__header">
          <h2>{{ 'products.facets.filter_by' | t }}</h2>
          <button type="button" class="header-icon" data-toggle-facets aria-label="{{ 'accessibility.close' | t }}">
            {% render 'icon', icon: 'close' %}
          </button>
        </div>

        {%- for filter in filters -%}
          <details class="facet-group" open>
            <summary>{{ filter.label }}</summary>
            {%- case filter.type -%}
              {%- when 'price_range' -%}
                <div class="facet-price">
                  <input
                    type="number"
                    name="{{ filter.min_value.param_name }}"
                    value="{{ filter.min_value.value }}"
                    placeholder="{{ 'products.facets.price_from' | t }}"
                    min="0"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    inputmode="decimal">
                  <span>–</span>
                  <input
                    type="number"
                    name="{{ filter.max_value.param_name }}"
                    value="{{ filter.max_value.value }}"
                    placeholder="{{ 'products.facets.price_to' | t }}"
                    min="0"
                    max="{{ filter.range_max | money_without_currency | replace: ',', '' }}"
                    inputmode="decimal">
                </div>
              {%- else -%}
                <ul class="facet-options">
                  {%- for value in filter.values -%}
                    <li>
                      <label class="facet-option">
                        <input
                          type="checkbox"
                          name="{{ value.param_name }}"
                          value="{{ value.value }}"
                          {% if value.active %}checked{% endif %}
                          {% if value.count == 0 and value.active == false %}disabled{% endif %}>
                        <span>{{ value.label }}</span>
                        <span class="count">{{ value.count }}</span>
                      </label>
                    </li>
                  {%- endfor -%}
                </ul>
            {%- endcase -%}
          </details>
        {%- endfor -%}

        <div class="facets__actions">
          <a href="{{ results.url | default: request.path }}" class="btn btn--outline btn--block">
            {{ 'products.facets.clear_all' | t }}
          </a>
          <button type="submit" class="btn btn--primary btn--block js-only" style="display:none">
            {{ 'products.facets.apply' | t }}
          </button>
        </div>
      </form>
    </div>
  </aside>
{%- endif -%}
