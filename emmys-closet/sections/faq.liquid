<div class="page-width section">
  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="faq">
    {%- comment -%} Build the ordered list of unique categories {%- endcomment -%}
    {%- assign cats = '' -%}
    {%- for block in section.blocks -%}
      {%- assign cat = block.settings.category | default: 'General' -%}
      {%- unless cats contains cat -%}{%- assign cats = cats | append: cat | append: '|||' -%}{%- endunless -%}
    {%- endfor -%}
    {%- assign cat_list = cats | split: '|||' -%}
    {%- for cat in cat_list -%}
      <div class="faq-cat">
        <h2>{{ cat }}</h2>
        <div class="faq-list">
          {%- for block in section.blocks -%}
            {%- assign bcat = block.settings.category | default: 'General' -%}
            {%- if bcat == cat -%}
              <details class="faq-item" {{ block.shopify_attributes }}>
                <summary>{{ block.settings.question }}</summary>
                <div class="faq-item__body rte">{{ block.settings.answer }}</div>
              </details>
            {%- endif -%}
          {%- endfor -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.settings.cta_heading != blank -%}
    <div class="cta-box" style="max-width:48rem;margin:var(--space-6) auto 0">
      <h3>{{ section.settings.cta_heading }}</h3>
      <p>{{ section.settings.cta_text }}</p>
      <div class="btn-row btn-row--center">
        {%- assign phone = settings.contact_phone | default: settings.phone -%}
        {%- if phone != blank -%}<a href="tel:{{ phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="btn btn--primary btn--pill">{% render 'icon', icon: 'phone' %} Call {{ phone }}</a>{%- endif -%}
        {%- if settings.contact_email != blank -%}<a href="mailto:{{ settings.contact_email }}" class="btn btn--outline btn--pill">{% render 'icon', icon: 'mail' %} Email Us</a>{%- endif -%}
      </div>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "FAQ",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Frequently Asked Questions" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "header", "content": "Bottom CTA" },
    { "type": "text", "id": "cta_heading", "label": "CTA heading", "default": "Still have questions?" },
    { "type": "textarea", "id": "cta_text", "label": "CTA text", "default": "Our team is happy to help. Reach out and we'll get back to you quickly." }
  ],
  "blocks": [
    {
      "type": "qa",
      "name": "Question",
      "settings": [
        { "type": "text", "id": "category", "label": "Category (repeat to group)", "default": "Orders & Shipping" },
        { "type": "text", "id": "question", "label": "Question", "default": "How long does shipping take?" },
        { "type": "richtext", "id": "answer", "label": "Answer", "default": "<p>We pack and ship orders within 1–2 business days, and shipping is free on U.S. orders over $75.</p>" }
      ]
    }
  ],
  "max_blocks": 30,
  "presets": [
    { "name": "FAQ" }
  ]
}
{% endschema %}
