<div class="page-width section">
  <div class="whyus__grid {% if section.settings.image_position == 'right' %}media-reverse{% endif %}">
    <div class="whyus__media" style="box-shadow:none">
      {%- if section.settings.image != blank -%}
        {% assign mt_alt = section.settings.heading | escape %}
        {{ section.settings.image | image_url: width: 1000 | image_tag: alt: mt_alt, loading: 'lazy', style: 'aspect-ratio:16/10;box-shadow:var(--shadow-lg)' }}
      {%- elsif section.settings.image_url != blank -%}
        <img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}" loading="lazy" style="aspect-ratio:16/10;box-shadow:var(--shadow-lg)">
      {%- else -%}
        <div class="media-ph">{% render 'icon', icon: 'sparkles' %}</div>
      {%- endif -%}
    </div>
    <div class="whyus__body">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      <div class="rte text-muted">{{ section.settings.text }}</div>
      {%- if section.settings.button_label != blank -%}
        <a href="{{ section.settings.button_link }}" class="btn btn--primary btn--pill" style="margin-top:var(--space-3)">{{ section.settings.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  @media (min-width: 990px) { #shopify-section-{{ section.id }} .media-reverse .whyus__media { order: 2; } }
</style>

{% schema %}
{
  "name": "Image with text",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Image" },
    { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
    { "type": "select", "id": "image_position", "label": "Image position", "default": "left", "options": [ { "value": "left", "label": "Left" }, { "value": "right", "label": "Right" } ] },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Our Story" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Classic style, lovingly curated" },
    { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Emmy's Closet began with a simple wish — to dress little ones in the timeless, beautifully made pieces that never go out of style. Think soft smocking, sweet gingham, delicate ruffles, and monograms made just for them.</p>" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Image with text" } ]
}
{% endschema %}
