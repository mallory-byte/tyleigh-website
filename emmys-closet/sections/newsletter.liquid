<div class="page-width section--sm">
  <div class="prose" style="text-align:center;max-width:34rem">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p class="text-muted">{{ section.settings.subtext }}</p>{%- endif -%}

    {%- form 'customer', id: 'NewsletterForm' -%}
      <input type="hidden" name="contact[tags]" value="newsletter">
      {%- if form.posted_successfully? -%}
        <div class="form-note form-note--success">{{ 'general.newsletter.success' | t }}</div>
      {%- else -%}
        <div class="search-form" style="max-width:26rem;margin:var(--space-4) auto 0">
          <label class="search-form__field">
            <span class="visually-hidden">{{ 'general.newsletter.label' | t }}</span>
            {% render 'icon', icon: 'mail' %}
            <input type="email" name="contact[email]" placeholder="{{ 'general.newsletter.placeholder' | t }}" required>
          </label>
          <button type="submit" class="btn btn--accent">{{ 'general.newsletter.button' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}
  </div>
</div>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Join the family" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Be first to shop new arrivals" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Sign up for sweet updates, early access, and a little something for your first order." }
  ],
  "presets": [ { "name": "Newsletter" } ]
}
{% endschema %}
