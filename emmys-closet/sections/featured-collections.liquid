{%- comment -%} Emmy's Closet — Shop by Category grid {%- endcomment -%}
<div class="page-width section" id="shop-by-category">
  <div class="section-head">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
  </div>

  <div class="cat-grid">
    {%- for block in section.blocks -%}
      {%- liquid
        assign coll = collections[block.settings.collection]
        assign card_url = block.settings.link | default: coll.url | default: '#'
        assign card_title = block.settings.title
        if card_title == blank
          assign card_title = coll.title | default: 'Shop'
        endif
        assign card_img = block.settings.image | default: coll.featured_image
      -%}
      <a href="{{ card_url }}" class="cat-card" {{ block.shopify_attributes }}>
        {%- if card_img != blank -%}
          {{ card_img | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 450, 600', sizes: '(min-width: 750px) 22vw, 45vw', alt: card_title | escape }}
        {%- elsif block.settings.image_url != blank -%}
          <img src="{{ block.settings.image_url }}" alt="{{ card_title | escape }}" loading="lazy">
        {%- else -%}
          <span class="cat-card__ph">{% render 'icon', icon: block.settings.icon | default: 'gift' %}</span>
        {%- endif -%}
        <span class="cat-card__overlay"></span>
        <span class="cat-card__label">
          <span>{{ card_title }}</span>
          {%- if block.settings.subtitle != blank -%}<small>{{ block.settings.subtitle }}</small>{%- endif -%}
        </span>
      </a>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Shop by category",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Shop by Category" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Find their perfect look" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "From smocked special occasion pieces to everyday essentials — sweetly curated for every little one." }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        { "type": "collection", "id": "collection", "label": "Collection" },
        { "type": "text", "id": "title", "label": "Title (overrides collection name)" },
        { "type": "text", "id": "subtitle", "label": "Subtitle", "default": "Shop now" },
        { "type": "image_picker", "id": "image", "label": "Image (overrides collection image)" },
        { "type": "text", "id": "image_url", "label": "Image URL (fallback)" },
        { "type": "url", "id": "link", "label": "Custom link (overrides collection URL)" },
        {
          "type": "select", "id": "icon", "label": "Placeholder icon", "default": "gift",
          "options": [
            { "value": "gift", "label": "Gift" },
            { "value": "baby", "label": "Baby" },
            { "value": "heart", "label": "Heart" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "star", "label": "Star" }
          ]
        }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category", "settings": { "title": "Girls", "subtitle": "Dresses & sets", "icon": "sparkles" } },
        { "type": "category", "settings": { "title": "Boys", "subtitle": "Classic & preppy", "icon": "star" } },
        { "type": "category", "settings": { "title": "Baby", "subtitle": "0–24 months", "icon": "baby" } },
        { "type": "category", "settings": { "title": "Accessories", "subtitle": "Bows, socks & more", "icon": "gift" } }
      ]
    }
  ]
}
{% endschema %}
