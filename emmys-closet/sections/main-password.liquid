<div class="page-width" style="max-width:34rem">
  <h1>{{ settings.brand_name | default: shop.name }}</h1>
  <p style="color:rgba(255,255,255,0.85)">{{ section.settings.message | default: shop.password_message | default: 'Opening soon. Enter the password to take a peek inside Emmy''s Closet.' }}</p>

  {%- form 'storefront_password' -%}
    {%- if form.errors -%}
      <div class="form-note form-note--error">{{ form.errors | default_errors }}</div>
    {%- endif -%}
    <div class="search-form" style="margin-top:var(--space-4)">
      <label class="search-form__field" style="background:#fff">
        <span class="visually-hidden">Password</span>
        <input type="password" name="password" placeholder="Password">
      </label>
      <button type="submit" class="btn btn--accent">Enter</button>
    </div>
  {%- endform -%}

  <p style="margin-top:var(--space-6);font-size:0.85rem;color:rgba(255,255,255,0.7)">
    Are you the store owner? <a href="/admin" style="color:var(--color-accent)">Log in here</a>.
  </p>
</div>

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "textarea", "id": "message", "label": "Message" }
  ]
}
{% endschema %}
