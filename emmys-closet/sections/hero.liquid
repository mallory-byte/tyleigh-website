{%- liquid
  assign btn_link = section.settings.button_link
  if btn_link == blank
    assign btn_link = routes.all_products_collection_url
  endif
  assign has_img = false
  if section.settings.image != blank or section.settings.image_url != blank
    assign has_img = true
  endif
-%}
<section class="hero{% unless has_img %} hero--placeholder{% endunless %}">
  {%- if section.settings.image != blank -%}
    <div class="hero__media">
      {{ section.settings.image | image_url: width: 2000 | image_tag: alt: section.settings.heading, loading: 'eager' }}
    </div>
  {%- elsif section.settings.image_url != blank -%}
    <div class="hero__media"><img src="{{ section.settings.image_url }}" alt="{{ section.settings.heading | escape }}"></div>
  {%- endif -%}
  <div class="hero__overlay"></div>

  <div class="page-width hero__inner">
    {%- if section.settings.eyebrow != blank -%}<p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>{%- endif -%}
    <h1>
      {{ section.settings.heading }}
      {%- if section.settings.heading_emphasis != blank -%}<br><em>{{ section.settings.heading_emphasis }}</em>{%- endif -%}
    </h1>
    {%- if section.settings.subtext != blank -%}<p class="hero__sub">{{ section.settings.subtext }}</p>{%- endif -%}

    <div class="hero__cta">
      {%- if section.settings.button_label != blank -%}
        <a href="{{ btn_link }}" class="btn btn--accent btn--lg btn--pill">{{ section.settings.button_label }}</a>
      {%- endif -%}
      {%- if section.settings.button_label_2 != blank -%}
        <a href="{{ section.settings.button_link_2 | default: '#' }}" class="btn btn--outline-light btn--lg btn--pill">{{ section.settings.button_label_2 }}</a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Background image" },
    { "type": "text", "id": "image_url", "label": "Background image URL (fallback)" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Emmy's Closet" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Timeless treasures" },
    { "type": "text", "id": "heading_emphasis", "label": "Accent heading", "default": "for little ones" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" },
    { "type": "text", "id": "button_label", "label": "Primary button", "default": "Shop New Arrivals" },
    { "type": "url", "id": "button_link", "label": "Primary button link" },
    { "type": "text", "id": "button_label_2", "label": "Secondary button" },
    { "type": "url", "id": "button_link_2", "label": "Secondary button link" }
  ],
  "presets": [{ "name": "Hero" }]
}
{% endschema %}
