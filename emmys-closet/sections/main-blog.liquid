<section class="page-hero">
  <div class="page-width">
    <h1>{{ blog.title }}</h1>
    <p>Style guides, gift ideas, and sweet stories from the Emmy's Closet family.</p>
  </div>
</section>

<div class="page-width section--sm">
  {%- paginate blog.articles by 9 -%}
    {%- if blog.articles.size > 0 -%}
      <div class="card-grid card-grid--4">
        {%- for article in blog.articles -%}
          <article class="p-card">
            {%- if article.image -%}
              <a href="{{ article.url }}" class="p-card__media">
                {{ article.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: article.title | escape }}
              </a>
            {%- endif -%}
            <div class="p-card__body">
              <span class="p-card__loc">{{ article.published_at | date: '%b %d, %Y' }}</span>
              <h3 class="p-card__title"><a href="{{ article.url }}">{{ article.title }}</a></h3>
              <p class="p-card__desc">{{ article.excerpt_or_content | strip_html | truncatewords: 22 }}</p>
              <a href="{{ article.url }}" class="btn btn--outline btn--block" style="margin-top:auto">Read more {% render 'icon', icon: 'arrow-right' %}</a>
            </div>
          </article>
        {%- endfor -%}
      </div>
      {% render 'pagination', paginate: paginate %}
    {%- else -%}
      <div class="empty-state"><p class="text-muted">No posts yet. Check back soon.</p></div>
    {%- endif -%}
  {%- endpaginate -%}
</div>

{% schema %}
{ "name": "Blog posts", "settings": [] }
{% endschema %}
