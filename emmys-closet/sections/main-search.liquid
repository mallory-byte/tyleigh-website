{%- liquid
  assign per_page = section.settings.results_per_page | default: 16
-%}
<section class="page-hero">
  <div class="page-width">
    <h1>Search</h1>
    <form action="{{ routes.search_url }}" method="get" class="search-form" role="search" style="max-width:38rem;margin:var(--space-5) auto 0">
      <input type="hidden" name="type" value="product">
      <label class="search-form__field">
        <span class="visually-hidden">{{ 'general.search.search' | t }}</span>
        {% render 'icon', icon: 'search' %}
        <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="Search dresses, sizes, brands…">
      </label>
      <button type="submit" class="btn btn--accent">{{ 'general.search.submit' | t }}</button>
    </form>
  </div>
</section>

<div class="page-width section--sm">
  {%- if search.performed -%}
    {%- paginate search.results by per_page -%}
      <p class="results-count">Showing <strong>{{ search.results_count }}</strong> result{% if search.results_count != 1 %}s{% endif %} for "{{ search.terms }}"</p>

      {%- if search.results.size > 0 -%}
        <div class="card-grid card-grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <article class="pc">
                <div class="pc__body" style="text-align:left">
                  <h3 class="pc__title"><a href="{{ item.url }}">{{ item.title }}</a></h3>
                  <p class="text-muted" style="font-size:0.9rem">{{ item.content | default: item.excerpt | strip_html | truncatewords: 20 }}</p>
                  <div class="pc__cta"><a href="{{ item.url }}" class="btn btn--outline btn--pill">Read more {% render 'icon', icon: 'arrow-right' %}</a></div>
                </div>
              </article>
            {%- endif -%}
          {%- endfor -%}
        </div>
        {% render 'pagination', paginate: paginate %}
      {%- else -%}
        <div class="empty-state">
          {% render 'icon', icon: 'search' %}
          <h3>No results for "{{ search.terms }}".</h3>
          <p class="text-muted">Try a different search, or browse everything in the shop.</p>
          <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--pill">Shop all</a>
        </div>
      {%- endif -%}
    {%- endpaginate -%}
  {%- else -%}
    <div class="empty-state">
      {% render 'icon', icon: 'search' %}
      <h3>What are you looking for?</h3>
      <p class="text-muted">Search by style, size, brand, or occasion.</p>
    </div>
  {%- endif -%}
</div>

{% schema %}
{
  "name": "Search results",
  "settings": [
    { "type": "range", "id": "results_per_page", "min": 8, "max": 24, "step": 4, "label": "Results per page", "default": 16 }
  ]
}
{% endschema %}
