<div class="page-width section {% if section.settings.muted_bg %}contact-section{% endif %}">
  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="card-grid card-grid--4" style="max-width:64rem;margin-inline:auto">
    {%- for block in section.blocks -%}
      <div class="prose-card" style="margin-bottom:0" {{ block.shopify_attributes }}>
        <span class="reason__icon" style="width:3rem;height:3rem;margin-bottom:var(--space-4)">{% render 'icon', icon: block.settings.icon %}</span>
        <h3 style="font-family:var(--font-body);font-size:1.1rem">{{ block.settings.title }}</h3>
        <p class="text-muted" style="font-size:0.9rem;margin-bottom:0">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Value cards",
  "settings": [
    { "type": "checkbox", "id": "muted_bg", "label": "Muted background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What We Stand For" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Core Values" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "heart",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "sparkles", "label": "Sparkles" },
            { "value": "gift", "label": "Gift" },
            { "value": "truck", "label": "Truck" },
            { "value": "refresh", "label": "Returns" },
            { "value": "star", "label": "Star" },
            { "value": "baby", "label": "Baby" },
            { "value": "shield", "label": "Shield" },
            { "value": "scissors", "label": "Scissors" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Made with love" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Thoughtfully chosen pieces, crafted to be treasured and passed down." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Value cards",
      "blocks": [
        { "type": "value", "settings": { "icon": "sparkles", "title": "Smocked & Monogrammed", "text": "Heirloom details, hand-smocking, and personalized monograms on our signature pieces." } },
        { "type": "value", "settings": { "icon": "gift", "title": "Free Gift Wrapping", "text": "Every order can arrive gift-ready — perfect for showers, birthdays, and holidays." } },
        { "type": "value", "settings": { "icon": "truck", "title": "Fast, Free Shipping", "text": "Complimentary U.S. shipping on orders over $75, packed and sent within 1–2 days." } },
        { "type": "value", "settings": { "icon": "refresh", "title": "Easy 30-Day Returns", "text": "Not quite right? Send unworn pieces back within 30 days — no fuss, no worries." } }
      ]
    }
  ]
}
{% endschema %}
