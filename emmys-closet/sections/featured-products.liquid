{%- comment -%} Emmy's Closet — featured products grid {%- endcomment -%}
{%- liquid
  assign coll = collections[section.settings.collection]
  assign limit = section.settings.products_to_show | default: 8
-%}
<section class="section {% if section.settings.muted_bg %}contact-section{% endif %}">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>

    {%- if coll and coll.products.size > 0 -%}
      <div class="card-grid card-grid--4">
        {%- for product in coll.products limit: limit -%}
          {% render 'product-card', product: product %}
        {%- endfor -%}
      </div>
      {%- if section.settings.show_view_all -%}
        <div class="text-center" style="margin-top:var(--space-7)">
          <a href="{{ coll.url | default: routes.all_products_collection_url }}" class="btn btn--outline btn--lg btn--pill">{{ section.settings.view_all_label | default: 'Shop the collection' }} {% render 'icon', icon: 'arrow-right' %}</a>
        </div>
      {%- endif -%}
    {%- else -%}
      <div class="empty-state">
        {% render 'icon', icon: 'gift' %}
        <p class="text-muted">Choose a collection in the theme editor to feature products here.</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Just In" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "New Arrivals" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Fresh little finds added weekly — shop them before they're gone." },
    { "type": "collection", "id": "collection", "label": "Collection" },
    { "type": "range", "id": "products_to_show", "min": 4, "max": 12, "step": 4, "label": "Products to show", "default": 8 },
    { "type": "checkbox", "id": "muted_bg", "label": "Muted background", "default": false },
    { "type": "checkbox", "id": "show_view_all", "label": "Show \"view all\" button", "default": true },
    { "type": "text", "id": "view_all_label", "label": "View-all button label", "default": "Shop the collection" }
  ],
  "presets": [
    { "name": "Featured products" }
  ]
}
{% endschema %}
