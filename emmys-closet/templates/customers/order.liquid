<div class="page-width section">
  <nav class="breadcrumb"><a href="{{ routes.account_url }}">Account</a><span>/</span>{{ order.name }}</nav>
  <h1>Order {{ order.name }}</h1>
  <p class="text-muted">Placed {{ order.created_at | date: '%B %d, %Y' }} · {{ order.financial_status }} · {{ order.fulfillment_status }}</p>

  <table style="width:100%;border-collapse:collapse;margin-top:var(--space-5)">
    <thead>
      <tr style="text-align:left;border-bottom:2px solid var(--color-border)">
        <th style="padding:var(--space-3)">Item</th>
        <th style="padding:var(--space-3)">Price</th>
        <th style="padding:var(--space-3)">Qty</th>
        <th style="padding:var(--space-3)">Total</th>
      </tr>
    </thead>
    <tbody>
      {%- for line_item in order.line_items -%}
        <tr style="border-bottom:1px solid var(--color-border)">
          <td style="padding:var(--space-3)"><a href="{{ line_item.product.url }}">{{ line_item.title }}</a></td>
          <td style="padding:var(--space-3)">{{ line_item.price | money }}</td>
          <td style="padding:var(--space-3)">{{ line_item.quantity }}</td>
          <td style="padding:var(--space-3)">{{ line_item.final_line_price | money }}</td>
        </tr>
      {%- endfor -%}
    </tbody>
    <tfoot>
      <tr><td colspan="3" style="padding:var(--space-3);text-align:right">Subtotal</td><td style="padding:var(--space-3)">{{ order.line_items_subtotal_price | money }}</td></tr>
      <tr><td colspan="3" style="padding:var(--space-3);text-align:right"><strong>Total</strong></td><td style="padding:var(--space-3)"><strong>{{ order.total_price | money }}</strong></td></tr>
    </tfoot>
  </table>
</div>
