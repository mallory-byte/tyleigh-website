# ─── Airtable ───────────────────────────────────────────────────────────────
# Personal Access Token with data.records:read + write on the base.
# Create at: https://airtable.com/create/tokens
AIRTABLE_TOKEN=

# Defaults already point at "Ty-Leigh Capital - Current" → Marketing table.
# Override only if they change.
AIRTABLE_BASE_ID=appjkXCrCh5S0E1YW
AIRTABLE_MARKETING_TABLE=tblRNpnPT4XONSkTw
AIRTABLE_ACTIVE_STATUS=Active — Live

# ─── Stripe ─────────────────────────────────────────────────────────────────
# Secret key (sk_live_... or sk_test_...) from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=
DOC_FEE=249

# ─── Optional: capture form submissions in Airtable ─────────────────────────
# Table IDs for dedicated website tables (recommended over your live CRM).
# Leave blank to skip writes (forms still work; submissions are logged).
AIRTABLE_CONTACT_TABLE=
AIRTABLE_RESERVATIONS_TABLE=

# ─── Optional: /admin editing ───────────────────────────────────────────────
# Set to "true" to let the /admin page edit listings in Airtable. Off by default.
ADMIN_WRITES=false

# ─── Optional ───────────────────────────────────────────────────────────────
# Only needed if Stripe redirects come back to the wrong host. Usually
# auto-detected from the request.
# APP_URL=https://www.tyleighcapital.com
