[
  {
    "name": "theme_info",
    "theme_name": "Ty-Leigh Capital Land Co.",
    "theme_version": "1.0.0",
    "theme_author": "Ty-Leigh Capital",
    "theme_documentation_url": "https://tyleighcapital.com",
    "theme_support_url": "https://tyleighcapital.com"
  },
  {
    "name": "Brand",
    "settings": [
      {
        "type": "text",
        "id": "brand_name",
        "label": "Brand name",
        "default": "Ty-Leigh Capital"
      },
      {
        "type": "text",
        "id": "brand_suffix",
        "label": "Brand suffix",
        "default": "Land Co."
      },
      {
        "type": "image_picker",
        "id": "logo",
        "label": "Logo image",
        "info": "Optional. If empty, the brand name is shown as text."
      },
      {
        "type": "text",
        "id": "logo_url",
        "label": "Logo image URL (fallback)",
        "info": "Used if no logo image is uploaded above.",
        "default": "https://tyleighcapital.com/cdn/shop/files/Ty-Leigh_Logo_Horizontal_3a69b52f-3b43-4873-8954-0c162d9ce6b1.png?v=1720196662"
      },
      {
        "type": "range",
        "id": "logo_width",
        "min": 80,
        "max": 320,
        "step": 10,
        "unit": "px",
        "label": "Logo width",
        "default": 170
      },
      {
        "type": "image_picker",
        "id": "favicon",
        "label": "Favicon"
      },
      {
        "type": "text",
        "id": "tagline",
        "label": "Tagline",
        "default": "Own Land. Start Today."
      },
      {
        "type": "text",
        "id": "phone",
        "label": "Phone (call or text)",
        "default": "(662) 442-4362"
      }
    ]
  },
  {
    "name": "Colors",
    "settings": [
      {
        "type": "header",
        "content": "Brand palette"
      },
      {
        "type": "color",
        "id": "color_primary",
        "label": "Primary (deep teal)",
        "default": "#024e5f"
      },
      {
        "type": "color",
        "id": "color_primary_dark",
        "label": "Primary dark / footer",
        "default": "#042028"
      },
      {
        "type": "color",
        "id": "color_accent",
        "label": "Accent (orange)",
        "default": "#f16522"
      },
      {
        "type": "color",
        "id": "color_text",
        "label": "Body text",
        "default": "#042028"
      },
      {
        "type": "color",
        "id": "color_muted",
        "label": "Muted text",
        "default": "#4b7c86"
      },
      {
        "type": "color",
        "id": "color_bg",
        "label": "Page background",
        "default": "#f3f6fb"
      },
      {
        "type": "color",
        "id": "color_surface",
        "label": "Card surface",
        "default": "#ffffff"
      },
      {
        "type": "color",
        "id": "color_border",
        "label": "Borders",
        "default": "#dbe1e9"
      }
    ]
  },
  {
    "name": "Typography",
    "settings": [
      {
        "type": "paragraph",
        "content": "Headings use Playfair Display and body text uses Inter (loaded from Google Fonts) to match the Ty-Leigh Capital brand."
      },
      {
        "type": "range",
        "id": "heading_scale",
        "min": 90,
        "max": 130,
        "step": 5,
        "unit": "%",
        "label": "Heading size scale",
        "default": 100
      }
    ]
  },
  {
    "name": "Layout",
    "settings": [
      {
        "type": "range",
        "id": "page_width",
        "min": 1100,
        "max": 1500,
        "step": 20,
        "unit": "px",
        "label": "Max content width",
        "default": 1280
      },
      {
        "type": "range",
        "id": "card_radius",
        "min": 0,
        "max": 24,
        "step": 2,
        "unit": "px",
        "label": "Corner radius",
        "default": 10
      }
    ]
  },
  {
    "name": "Product cards",
    "settings": [
      {
        "type": "checkbox",
        "id": "show_acreage_badge",
        "label": "Show acreage badge",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_state_label",
        "label": "Show county / state label",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_status_badge",
        "label": "Show status badge (available / pending / sold)",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_features",
        "label": "Show feature tags",
        "default": true
      },
      {
        "type": "checkbox",
        "id": "show_monthly_price",
        "label": "Show owner-financing (monthly) pricing",
        "default": true
      }
    ]
  },
  {
    "name": "Social & contact",
    "settings": [
      {
        "type": "text",
        "id": "contact_email",
        "label": "Contact email",
        "default": "info@tyleighcapital.com"
      },
      {
        "type": "text",
        "id": "contact_phone",
        "label": "Contact phone",
        "default": "(662) 442-4362"
      },
      {
        "type": "text",
        "id": "hours_weekday",
        "label": "Weekday hours",
        "default": "Mon–Fri: 9am–6pm CT"
      },
      {
        "type": "text",
        "id": "hours_weekend",
        "label": "Weekend hours",
        "default": "Sat: 10am–4pm CT"
      },
      {
        "type": "url",
        "id": "social_facebook",
        "label": "Facebook URL"
      },
      {
        "type": "url",
        "id": "social_instagram",
        "label": "Instagram URL"
      },
      {
        "type": "url",
        "id": "social_youtube",
        "label": "YouTube URL"
      },
      {
        "type": "url",
        "id": "social_linkedin",
        "label": "LinkedIn URL"
      }
    ]
  }
]
