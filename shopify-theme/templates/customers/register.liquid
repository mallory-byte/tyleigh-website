<div class="page-width section" style="max-width:26rem">
  <h1 class="text-center">Create account</h1>
  {%- form 'create_customer' -%}
    {%- if form.errors -%}<div class="form-note form-note--error">{{ form.errors | default_errors }}</div>{%- endif -%}
    <div class="form-grid">
      <div class="form-field"><label for="FirstName">First name</label><input type="text" name="customer[first_name]" id="FirstName" autocomplete="given-name"></div>
      <div class="form-field"><label for="LastName">Last name</label><input type="text" name="customer[last_name]" id="LastName" autocomplete="family-name"></div>
    </div>
    <div class="form-field"><label for="Email">Email</label><input type="email" name="customer[email]" id="Email" autocomplete="email" required></div>
    <div class="form-field"><label for="Password">Password</label><input type="password" name="customer[password]" id="Password" autocomplete="new-password" required></div>
    <button type="submit" class="btn btn--primary btn--block btn--lg">Create account</button>
    <p class="text-center" style="margin-top:var(--space-4)">Already have an account? <a href="{{ routes.account_login_url }}">Log in</a></p>
  {%- endform -%}
</div>
