{%- comment -%}
  Reusable Property Finder quiz. Renders both as a full page section and inside
  the site popup. Every instance is scoped by a unique `uid` so multiple copies
  can coexist on one page without id collisions.

  Params:
    uid         (required) unique string, e.g. 'page' or 'popup'
    col         (required) a collection object to match against
    api         finder API endpoint (auto-emails matches when set)
    eyebrow, heading, subheading, cta_label   copy overrides
{%- endcomment -%}
{%- liquid
  assign uid = uid | default: 'page'
  assign eyebrow = eyebrow | default: 'Find Your Land'
  assign heading = heading | default: 'See Every Property You Can Afford'
  assign subheading = subheading | default: 'Find land based on your monthly budget—not just the purchase price.'
  assign cta_label = cta_label | default: 'Find My Land →'
-%}
<div class="finder" id="finder-{{ uid }}" data-uid="{{ uid }}" data-api="{{ api }}">
  <div class="finder__inner">

    {%- comment -%} STEP 1 — landing {%- endcomment -%}
    <div class="finder-step is-active" data-step="intro">
      <span class="eyebrow">{{ eyebrow }}</span>
      <h2 class="finder__h1">{{ heading }}</h2>
      <p class="finder__sub">{{ subheading }}</p>
      <button type="button" class="btn btn--accent btn--lg" data-next>{{ cta_label }}</button>
      <p class="finder__meta">Takes 20 seconds · No account needed</p>
    </div>

    {%- comment -%} STEP 2a — budget {%- endcomment -%}
    <div class="finder-step" data-step="budget">
      <div class="finder__count-of">Question 1 of 3</div>
      <h2 class="finder__q">What's your monthly budget?</h2>
      <div class="finder-options">
        <button type="button" class="finder-opt" data-q="budget" data-val="100">Under $100</button>
        <button type="button" class="finder-opt" data-q="budget" data-val="200">$100–200</button>
        <button type="button" class="finder-opt" data-q="budget" data-val="300">$200–300</button>
        <button type="button" class="finder-opt" data-q="budget" data-val="500">$300–500</button>
        <button type="button" class="finder-opt" data-q="budget" data-val="99999">$500+</button>
      </div>
    </div>

    {%- comment -%} STEP 2b — down payment {%- endcomment -%}
    <div class="finder-step" data-step="down">
      <div class="finder__count-of">Question 2 of 3</div>
      <h2 class="finder__q">How much can you put down?</h2>
      <div class="finder-options">
        <button type="button" class="finder-opt" data-q="down" data-val="0">$0</button>
        <button type="button" class="finder-opt" data-q="down" data-val="199">$199</button>
        <button type="button" class="finder-opt" data-q="down" data-val="500">$500</button>
        <button type="button" class="finder-opt" data-q="down" data-val="99999">$1,000+</button>
        <button type="button" class="finder-opt" data-q="down" data-val="custom">Custom</button>
      </div>
    </div>

    {%- comment -%} STEP 2c — location {%- endcomment -%}
    <div class="finder-step" data-step="state">
      <div class="finder__count-of">Question 3 of 3</div>
      <h2 class="finder__q">Where do you want land?</h2>
      <div class="finder-options">
        <button type="button" class="finder-opt" data-q="state" data-val="Colorado">Colorado</button>
        <button type="button" class="finder-opt" data-q="state" data-val="Florida">Florida</button>
        <button type="button" class="finder-opt" data-q="state" data-val="Nevada">Nevada</button>
        <button type="button" class="finder-opt" data-q="state" data-val="Arizona">Arizona</button>
        <button type="button" class="finder-opt" data-q="state" data-val="Anywhere">Anywhere</button>
      </div>
    </div>

    {%- comment -%} STEP 3 — loading {%- endcomment -%}
    <div class="finder-step" data-step="loading">
      <div class="finder-spinner" aria-hidden="true"></div>
      <h2 class="finder__q">🔍 Finding properties that match your budget…</h2>
      <p class="finder__sub">Matching your budget against every available parcel.</p>
    </div>

    {%- comment -%} STEP 4 — email gate {%- endcomment -%}
    <div class="finder-step" data-step="gate">
      <div class="finder-count"><span data-count>—</span> properties match your budget</div>
      <h2 class="finder__q">Where should we send your personalized property list?</h2>
      <ul class="finder-benefits">
        <li>{% render 'icon', icon: 'check-circle' %} Every property that matches your budget</li>
        <li>{% render 'icon', icon: 'check-circle' %} Monthly payment estimates</li>
        <li>{% render 'icon', icon: 'check-circle' %} GPS coordinates</li>
        <li>{% render 'icon', icon: 'check-circle' %} Maps &amp; property details</li>
        <li>{% render 'icon', icon: 'check-circle' %} New listings before they're posted publicly</li>
      </ul>
      {%- form 'customer', id: 'FinderForm-' | append: uid -%}
        <input type="hidden" name="contact[tags]" data-tags value="land-finder">
        <input type="hidden" name="contact[note]" data-note value="">
        <div class="finder-emailrow">
          <label class="search-form__field">
            <span class="visually-hidden">Email address</span>
            {% render 'icon', icon: 'mail' %}
            <input type="email" name="contact[email]" placeholder="you@email.com" required>
          </label>
          <button type="submit" class="btn btn--accent btn--lg btn--block">📧 Send My Property List</button>
        </div>
      {%- endform -%}
      <p class="finder__meta">No spam. Just land that fits your budget.</p>
    </div>

    {%- comment -%} STEP 5 — results {%- endcomment -%}
    <div class="finder-step" data-step="results">
      <h2 class="finder__q">Here's what fits your budget</h2>
      <p class="finder__sub" data-results-sub></p>
      <div class="finder-results" data-results></div>
      <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary">Browse all properties →</a>
    </div>

  </div>
</div>

<script id="finder-data-{{ uid }}" type="application/json">
[
  {%- assign firstp = true -%}
  {%- for product in col.products -%}
    {%- assign pm = product.metafields.custom -%}
    {%- if pm.monthly_payment.value != blank -%}
      {%- unless firstp -%},{%- endunless -%}{%- assign firstp = false -%}
      {
        "title": {{ product.title | json }},
        "url": {{ product.url | json }},
        "img": {{ product.featured_image | image_url: width: 480 | json }},
        "monthly": {{ pm.monthly_payment.value | json }},
        "down": {{ pm.down_payment.value | json }},
        "state": {{ pm.state.value | json }},
        "county": {{ pm.county.value | json }},
        "acres": {{ pm.acres.value | json }}
      }
    {%- endif -%}
  {%- endfor -%}
]
</script>

<script>
  (function () {
    var uid = {{ uid | json }};
    var root = document.getElementById("finder-" + uid);
    if (!root) return;
    var data = [];
    try { data = JSON.parse(document.getElementById("finder-data-" + uid).textContent || "[]"); } catch (e) { data = []; }
    var steps = root.querySelectorAll(".finder-step");
    var answers = {};

    function show(name) {
      steps.forEach(function (s) { s.classList.toggle("is-active", s.getAttribute("data-step") === name); });
      try { root.scrollIntoView({ behavior: "smooth", block: "nearest" }); } catch (e) {}
    }
    function num(v) { var n = parseFloat(v); return isNaN(n) ? null : n; }

    function matches() {
      return data.filter(function (p) {
        var m = num(p.monthly), d = num(p.down);
        if (answers.budget != null && m !== null && m > answers.budget) return false;
        if (answers.down != null && d !== null && d > answers.down) return false;
        if (answers.state && answers.state !== "Anywhere" && (p.state || "").toLowerCase() !== answers.state.toLowerCase()) return false;
        return true;
      });
    }

    function save() { try { localStorage.setItem("tyl_finder", JSON.stringify(answers)); } catch (e) {} }
    function load() { try { return JSON.parse(localStorage.getItem("tyl_finder") || "{}"); } catch (e) { return {}; } }

    root.querySelectorAll("[data-next]").forEach(function (b) {
      b.addEventListener("click", function () { show("budget"); });
    });

    var order = ["budget", "down", "state"];
    root.querySelectorAll(".finder-opt").forEach(function (b) {
      b.addEventListener("click", function () {
        var q = b.getAttribute("data-q"), val = b.getAttribute("data-val");
        if (q === "budget") answers.budget = parseFloat(val);
        else if (q === "down") answers.down = (val === "custom" ? Infinity : parseFloat(val));
        else if (q === "state") answers.state = val;
        var group = b.parentNode.querySelectorAll(".finder-opt");
        group.forEach(function (x) { x.classList.remove("is-sel"); });
        b.classList.add("is-sel");
        var nxt = order[order.indexOf(q) + 1];
        setTimeout(function () { nxt ? show(nxt) : runLoading(); }, 200);
      });
    });

    function runLoading() {
      show("loading");
      save();
      setTimeout(function () {
        var n = matches().length;
        var c = root.querySelector("[data-count]");
        if (c) c.textContent = n > 0 ? n : data.length;
        show("gate");
      }, 1800);
    }

    var api = (root.getAttribute("data-api") || "").trim();
    function absolutize(list) {
      return list.map(function (p) {
        var o = {}; for (var k in p) o[k] = p[k];
        if (o.url && o.url.indexOf("http") !== 0) o.url = location.origin + o.url;
        if (o.img && o.img.indexOf("//") === 0) o.img = "https:" + o.img;
        return o;
      });
    }
    var form = document.getElementById("FinderForm-" + uid);
    if (form) {
      form.addEventListener("submit", function (e) {
        var tags = "land-finder";
        if (answers.budget) tags += ", budget-" + (answers.budget >= 99999 ? "500plus" : answers.budget);
        if (answers.state) tags += ", area-" + answers.state.toLowerCase();
        var t = form.querySelector("[data-tags]"); if (t) t.value = tags;
        var note = form.querySelector("[data-note]");
        if (note) note.value = "Land Finder — budget up to $" + (answers.budget || "?") + "/mo, can put down $" + (answers.down === Infinity ? "1000+" : answers.down) + ", wants: " + (answers.state || "Anywhere");
        save();

        // Fully-automated path: POST to the finder endpoint, then show results
        // in place (no reload). Falls back to the Shopify customer form if no API.
        if (api) {
          e.preventDefault();
          var emailEl = form.querySelector('input[type="email"]');
          var btn = form.querySelector('button[type="submit"]');
          if (btn) { btn.disabled = true; btn.textContent = "Sending…"; }
          var payload = { email: emailEl ? emailEl.value : "", answers: answers, matches: absolutize(matches()) };
          fetch(api, { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(payload) })
            .catch(function () {})
            .then(function () { renderResults(); show("results"); });
        }
      });
    }

    function renderResults() {
      var ms = matches();
      var list = ms.length ? ms : data;
      var sub = root.querySelector("[data-results-sub]");
      if (sub) {
        sub.textContent = ms.length
          ? ("We found " + ms.length + " propert" + (ms.length === 1 ? "y" : "ies") + " that fit your budget. A copy is on its way to your inbox.")
          : "No exact match yet — here's everything available. We'll email you the moment something fits.";
      }
      var wrap = root.querySelector("[data-results]");
      if (!wrap) return;
      wrap.innerHTML = list.map(function (p) {
        var loc = [p.county ? p.county + " County" : "", p.state].filter(Boolean).join(", ");
        return '<a class="finder-card" href="' + p.url + '">' +
          (p.img ? '<img src="' + p.img + '" alt="" loading="lazy">' : '') +
          '<div class="finder-card__b">' +
          '<div class="finder-card__t">' + (p.title || "Property") + '</div>' +
          (loc ? '<div class="finder-card__loc">' + loc + '</div>' : '') +
          '<div class="finder-card__price">$' + (p.monthly || "?") + '<span>/mo</span></div>' +
          '</div></a>';
      }).join("");
    }

    if (root.getAttribute("data-posted") === "true") {
      answers = load();
      renderResults();
      show("results");
    }
  })();
</script>
