{%- comment -%} Open Graph + Twitter card meta tags {%- endcomment -%}
{%- liquid
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  else
    assign og_type = 'website'
  endif

  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | default: shop.name

  if template.name == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image | image_url: width: 1200
  elsif settings.logo
    assign og_image = settings.logo | image_url: width: 1200
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      "brand": { "@type": "Brand", "name": {{ settings.brand_name | default: shop.name | json }} },
      {% if product.featured_media %}"image": ["https:{{ product.featured_media | image_url: width: 1200 }}"],{% endif %}
      "url": {{ shop.url | append: product.url | json }},
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/SoldOut{% endif %}"
      }
    }
  </script>
{%- endif -%}

{%- comment -%} Organization schema (once, on the homepage) {%- endcomment -%}
{%- if template.name == 'index' -%}
  {%- assign org_phone = settings.contact_phone | default: settings.phone -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "Organization",
      "name": {{ settings.brand_name | default: shop.name | json }},
      "url": {{ shop.url | json }},
      {%- if settings.logo_url != blank -%}"logo": {{ settings.logo_url | json }},{%- endif -%}
      "description": {{ shop.description | default: 'Affordable owner-financed vacant land across the United States. No credit check, no hassle.' | json }},
      "areaServed": "United States",
      "contactPoint": {
        "@type": "ContactPoint",
        "contactType": "sales"
        {%- if org_phone != blank -%}, "telephone": {{ org_phone | json }}{%- endif -%}
        {%- if settings.contact_email != blank -%}, "email": {{ settings.contact_email | json }}{%- endif -%}
      }
      {%- assign socials = '' -%}
      {%- if settings.social_facebook != blank -%}{%- assign socials = socials | append: settings.social_facebook | append: '|||' -%}{%- endif -%}
      {%- if settings.social_instagram != blank -%}{%- assign socials = socials | append: settings.social_instagram | append: '|||' -%}{%- endif -%}
      {%- if settings.social_youtube != blank -%}{%- assign socials = socials | append: settings.social_youtube | append: '|||' -%}{%- endif -%}
      {%- if settings.social_linkedin != blank -%}{%- assign socials = socials | append: settings.social_linkedin | append: '|||' -%}{%- endif -%}
      {%- assign social_list = socials | split: '|||' -%}
      {%- if social_list.size > 0 -%}
        , "sameAs": [
          {%- for s in social_list -%}{% unless forloop.first %},{% endunless %}{{ s | json }}{%- endfor -%}
        ]
      {%- endif -%}
    }
  </script>
{%- endif -%}
