{%- comment -%} Open Graph + Twitter card meta tags {%- endcomment -%}
{%- liquid
  if template.name == 'product'
    assign og_type = 'product'
  elsif template.name == 'article'
    assign og_type = 'article'
  else
    assign og_type = 'website'
  endif

  assign og_title = page_title | default: shop.name
  assign og_desc = page_description | default: shop.description | default: shop.name

  if template.name == 'product' and product.featured_media
    assign og_image = product.featured_media | image_url: width: 1200
  elsif template.name == 'collection' and collection.image
    assign og_image = collection.image | image_url: width: 1200
  elsif settings.logo
    assign og_image = settings.logo | image_url: width: 1200
  endif
-%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:type" content="{{ og_type }}">
<meta property="og:title" content="{{ og_title | escape }}">
<meta property="og:description" content="{{ og_desc | escape }}">
<meta property="og:url" content="{{ canonical_url }}">
{%- if og_image -%}
  <meta property="og:image" content="https:{{ og_image }}">
  <meta name="twitter:card" content="summary_large_image">
{%- else -%}
  <meta name="twitter:card" content="summary">
{%- endif -%}
<meta name="twitter:title" content="{{ og_title | escape }}">
<meta name="twitter:description" content="{{ og_desc | escape }}">

{%- if template.name == 'product' -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org/",
      "@type": "Product",
      "name": {{ product.title | json }},
      "description": {{ product.description | strip_html | truncate: 300 | json }},
      {% if product.featured_media %}"image": ["https:{{ product.featured_media | image_url: width: 1200 }}"],{% endif %}
      "url": {{ shop.url | append: product.url | json }},
      "offers": {
        "@type": "Offer",
        "priceCurrency": {{ cart.currency.iso_code | json }},
        "price": {{ product.price | divided_by: 100.0 | json }},
        "availability": "{% if product.available %}https://schema.org/InStock{% else %}https://schema.org/SoldOut{% endif %}"
      }
    }
  </script>
{%- endif -%}
