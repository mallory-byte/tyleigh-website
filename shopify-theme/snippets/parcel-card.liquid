{%- comment -%}
  Property (parcel) card — matches Ty-Leigh Capital design.
  Params: product (required)
  Metafields (custom namespace): state, county, acres, monthly_payment,
  down_payment, status, features (list). Cash price = product price.
{%- endcomment -%}
{%- liquid
  assign m = product.metafields.custom
  assign acres = m.acres.value | default: m.acreage.value
  assign state = m.state.value
  assign county = m.county.value
  assign monthly = m.monthly_payment.value
  assign down = m.down_payment.value
  assign features = m.features.value
  assign cash = m.cash_price.value
  if cash != blank
    assign cash_display = cash | times: 100 | money_without_trailing_zeros
  else
    assign cash_display = product.price | money
  endif

  assign status = m.status.value | downcase
  if status == blank
    if product.available
      assign status = 'available'
    else
      assign status = 'sold'
    endif
  endif
-%}
<article class="p-card">
  <a href="{{ product.url }}" class="p-card__media" aria-label="{{ product.title | escape }}">
    {%- if product.featured_media -%}
      {{ product.featured_media | image_url: width: 700 | image_tag: loading: 'lazy', widths: '350, 525, 700', sizes: '(min-width: 900px) 25vw, 90vw', alt: product.featured_media.alt | default: product.title | escape }}
    {%- else -%}
      <span style="display:grid;place-items:center;height:100%;color:var(--color-muted)">{% render 'icon', icon: 'tree' %}</span>
    {%- endif -%}
    {%- if settings.show_status_badge -%}
      <span class="p-card__status status--{{ status }}">{{ status }}</span>
    {%- endif -%}
    {%- if settings.show_acreage_badge and acres != blank -%}
      <span class="p-card__acres">{{ acres }} acres</span>
    {%- endif -%}
  </a>

  <div class="p-card__body">
    <h3 class="p-card__title"><a href="{{ product.url }}">{{ product.title }}</a></h3>
    {%- if settings.show_state_label and state != blank -%}
      <span class="p-card__loc">{% render 'icon', icon: 'map-pin' %}{% if county != blank %}{{ county }} County, {% endif %}{{ state }}</span>
    {%- endif -%}
    {%- if product.description != blank -%}
      <p class="p-card__desc">{{ product.description | strip_html | truncatewords: 22 }}</p>
    {%- endif -%}

    {%- if settings.show_features and features != blank and features != empty -%}
      <div class="p-card__tags">
        {%- for f in features limit: 3 -%}<span class="tag">{{ f }}</span>{%- endfor -%}
      </div>
    {%- endif -%}

    <div class="p-card__pricing">
      <div class="price-fin">
        {%- if settings.show_monthly_price and monthly != blank -%}
          <div class="price-fin__label">Owner Financing</div>
          <div class="price-fin__amount">${{ monthly }}<small>/mo</small></div>
          {%- if down != blank -%}<div class="price-fin__down">Down: ${{ down }}</div>{%- endif -%}
        {%- else -%}
          <div class="price-fin__label">Cash Price</div>
          <div class="price-fin__amount">{{ cash_display }}</div>
        {%- endif -%}
      </div>
      {%- if settings.show_monthly_price and monthly != blank -%}
        <div class="price-cash">
          <div class="price-cash__label">Cash Price</div>
          <div class="price-cash__amount">{{ cash_display }}</div>
        </div>
      {%- endif -%}
    </div>

    {%- if status == 'available' -%}
      <a href="{{ product.url }}" class="btn btn--primary btn--block">View Listing {% render 'icon', icon: 'arrow-right' %}</a>
    {%- elsif status == 'pending' -%}
      <span class="btn btn--block is-disabled" style="background:#e6b800;color:#fff">Under Contract</span>
    {%- else -%}
      <span class="btn btn--outline btn--block is-disabled">Sold</span>
    {%- endif -%}
  </div>
</article>
