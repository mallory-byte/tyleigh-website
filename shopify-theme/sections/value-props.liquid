<div class="page-width section {% if section.settings.muted_bg %}contact-section{% endif %}">
  {%- if section.settings.heading != blank -%}
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>
  {%- endif -%}

  <div class="card-grid card-grid--4" style="max-width:64rem;margin-inline:auto">
    {%- for block in section.blocks -%}
      <div class="prose-card" style="margin-bottom:0" {{ block.shopify_attributes }}>
        <span class="reason__icon" style="width:3rem;height:3rem;margin-bottom:var(--space-4)">{% render 'icon', icon: block.settings.icon %}</span>
        <h3 style="font-family:var(--font-body);font-size:1.1rem">{{ block.settings.title }}</h3>
        <p class="text-muted" style="font-size:0.9rem;margin-bottom:0">{{ block.settings.text }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Value cards",
  "settings": [
    { "type": "checkbox", "id": "muted_bg", "label": "Muted background", "default": true },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "What We Stand For" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Our Core Values" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" }
  ],
  "blocks": [
    {
      "type": "value",
      "name": "Value",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "heart",
          "options": [
            { "value": "heart", "label": "Heart" },
            { "value": "shield", "label": "Shield" },
            { "value": "users", "label": "Users" },
            { "value": "trending-up", "label": "Trending up" },
            { "value": "credit-card", "label": "Credit card" },
            { "value": "handshake", "label": "Handshake" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "People First" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "We believe land ownership should be accessible to everyone — not just those with perfect credit or deep pockets." }
      ]
    }
  ],
  "max_blocks": 8,
  "presets": [
    {
      "name": "Value cards",
      "blocks": [
        { "type": "value", "settings": { "icon": "heart", "title": "People First", "text": "We believe land ownership should be accessible to everyone — not just those with perfect credit or deep pockets. Our owner-financing model was built with families in mind." } },
        { "type": "value", "settings": { "icon": "shield", "title": "Transparent & Honest", "text": "No hidden fees. No tricks. What you see is what you get. We clearly outline all terms upfront so you can make an informed decision with confidence." } },
        { "type": "value", "settings": { "icon": "users", "title": "Community Focused", "text": "From Mississippi roots, we've grown to help buyers across the country find their piece of land. Your success is our success." } },
        { "type": "value", "settings": { "icon": "trending-up", "title": "Long-Term Investment", "text": "Land appreciates over time. We help you start building wealth today — even on a modest budget — with flexible monthly payments that fit your life." } }
      ]
    }
  ]
}
{% endschema %}
