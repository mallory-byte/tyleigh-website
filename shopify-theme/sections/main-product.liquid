{%- liquid
  assign p = product
  assign m = product.metafields.custom
  assign acres = m.acres.value | default: m.acreage.value
  assign state = m.state.value
  assign county = m.county.value
  assign monthly = m.monthly_payment.value
  assign down = m.down_payment.value
  assign term = m.term_months.value | default: settings.finance_term_months
  assign cash = m.cash_price.value
  if cash != blank
    assign cash_display = cash | times: 100 | money_without_trailing_zeros
  else
    assign cash_display = 'Contact for price'
  endif
  assign parcel_no = m.parcel_number.value | default: m.apn.value
  assign legal = m.legal_description.value
  assign access = m.access.value
  assign power = m.power.value
  assign water = m.water.value
  assign septic = m.septic.value
  assign zoning = m.zoning.value
  assign elevation = m.elevation.value
  assign lat = m.latitude.value
  assign lng = m.longitude.value
  assign features = m.features.value
  assign doc_fee = m.doc_fee.value | default: section.settings.doc_fee | default: 249
  assign doc_cents = doc_fee | times: 100

  assign status = m.status.value | downcase
  if status == blank
    if p.available
      assign status = 'available'
    else
      assign status = 'sold'
    endif
  endif
-%}

<div class="page-width pdp section--sm">
  <a href="{{ routes.all_products_collection_url }}" class="back-link">{% render 'icon', icon: 'arrow-left' %} Back to All Listings</a>

  <div class="pdp__grid">
    {%- comment -%} ---------- Main column ---------- {%- endcomment -%}
    <div class="pdp__main" data-gallery>
      <div>
        <div class="pdp-hero" data-gallery-main {% if p.featured_media %}data-zoom-open role="button" tabindex="0" aria-label="Click to enlarge photo"{% endif %}>
          {%- if p.featured_media -%}
            {% assign product_alt = p.featured_media.alt | default: p.title | escape %}
            {{ p.featured_media | image_url: width: 1600 | image_tag: alt: product_alt, fetchpriority: 'high' }}
            <span class="pdp-hero__zoom">{% render 'icon', icon: 'maximize' %} Click to zoom</span>
          {%- else -%}
            <div style="height:24rem;display:grid;place-items:center;background:var(--color-bg);color:var(--color-muted)">{% render 'icon', icon: 'tree' %}</div>
          {%- endif -%}
          {%- if settings.show_status_badge -%}<span class="pdp-hero__status status--{{ status }}">{{ status }}</span>{%- endif -%}
          {%- if acres != blank -%}<span class="pdp-hero__acres">{{ acres }} Acres</span>{%- endif -%}
        </div>
        {%- if p.media.size > 1 -%}
          <div class="pdp-thumbs">
            {%- for media in p.media -%}
              <button type="button" class="pdp-thumb" data-gallery-thumb data-full="{{ media | image_url: width: 1400 }}" data-alt="{{ media.alt | default: p.title | escape }}" aria-current="{% if forloop.first %}true{% else %}false{% endif %}">
                {{ media | image_url: width: 160 | image_tag: loading: 'lazy', alt: media.alt | default: p.title | escape }}
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      <div class="pdp__title-row">
        <div>
          <h1>{{ p.title }}</h1>
          {%- if state != blank -%}
            <span class="pdp__loc">{% render 'icon', icon: 'map-pin' %}{% if county != blank %}{{ county }} County, {% endif %}{{ state }}</span>
          {%- endif -%}
        </div>

        {%- assign share_url = canonical_url | default: p.url -%}
        <div class="share" data-share>
          <button type="button" class="btn btn--outline share__btn" data-share-btn aria-haspopup="true" aria-expanded="false">
            {% render 'icon', icon: 'share' %} Share
          </button>
          <div class="share__menu" data-share-menu hidden>
            <button type="button" class="share__item" data-share-copy>{% render 'icon', icon: 'link' %} <span data-copy-label>Copy link</span></button>
            <a class="share__item" href="https://www.facebook.com/sharer/sharer.php?u={{ share_url | url_encode }}" target="_blank" rel="noopener">{% render 'icon', icon: 'facebook' %} Facebook</a>
            <a class="share__item" href="https://twitter.com/intent/tweet?url={{ share_url | url_encode }}&text={{ p.title | url_encode }}" target="_blank" rel="noopener">{% render 'icon', icon: 'x-twitter' %} Post on X</a>
            <a class="share__item" href="mailto:?subject={{ p.title | url_encode }}&body={{ share_url | url_encode }}">{% render 'icon', icon: 'mail' %} Email</a>
            <a class="share__item" href="sms:?&body={{ p.title | url_encode }}%20{{ share_url | url_encode }}">{% render 'icon', icon: 'message' %} Text a friend</a>
          </div>
        </div>
      </div>

      {%- if p.description != blank -%}
        <div class="pdp-section">
          <h2>Description</h2>
          <div class="rte text-muted">{{ p.description }}</div>
        </div>
      {%- endif -%}

      {%- comment -%} ---- Property Information ---- {%- endcomment -%}
      <div class="pdp-section">
        <h2>Property Information</h2>
        <dl class="info-rows">
          {%- if acres != blank -%}<div class="info-row"><dt>Parcel Size</dt><dd>{{ acres }} Acres ({{ acres | times: 43560 | round }} sq ft)</dd></div>{%- endif -%}
          {%- if state != blank -%}<div class="info-row"><dt>State</dt><dd>{{ state }}</dd></div>{%- endif -%}
          {%- if county != blank -%}<div class="info-row"><dt>County</dt><dd>{{ county }} County</dd></div>{%- endif -%}
          {%- if parcel_no != blank -%}<div class="info-row"><dt>Parcel Number</dt><dd>{{ parcel_no }}</dd></div>{%- endif -%}
          {%- if legal != blank -%}<div class="info-row"><dt>Legal Description</dt><dd>{{ legal }}</dd></div>{%- endif -%}
        </dl>
        {%- if parcel_no != blank or lat != blank -%}
          <div class="verify-box">
            <span class="verify-box__icon">{% render 'icon', icon: 'check-circle' %}</span>
            <div class="verify-box__body">
              <p class="verify-box__title">Verify this parcel yourself</p>
              <p class="verify-box__text">This is a real, recorded parcel — don't just take our word for it. Look it up:</p>
              <div class="verify-box__links">
                {%- if lat != blank and lng != blank -%}
                  <a href="https://www.google.com/maps/search/?api=1&query={{ lat }},{{ lng }}" target="_blank" rel="noopener">{% render 'icon', icon: 'navigation' %} See the exact location on a map</a>
                {%- endif -%}
                {%- if parcel_no != blank -%}
                  <a href="https://www.google.com/search?q={{ parcel_no | url_encode }}+{{ county | url_encode }}+county+{{ state | url_encode }}+assessor" target="_blank" rel="noopener">{% render 'icon', icon: 'search' %} Look up APN {{ parcel_no }} on the county records</a>
                {%- endif -%}
              </div>
            </div>
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---- Property Features ---- {%- endcomment -%}
      {%- if acres != blank or access != blank or power != blank or water != blank or zoning != blank -%}
        <div class="pdp-section">
          <h2>Property Features</h2>
          <div class="features-grid">
            {%- if acres != blank -%}<div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'ruler' %}</span><span class="feature-tile__label">Acres</span><span class="feature-tile__value">{{ acres }} ac</span></div>{%- endif -%}
            {%- if county != blank -%}<div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'building' %}</span><span class="feature-tile__label">County</span><span class="feature-tile__value">{{ county }} Co.</span></div>{%- endif -%}
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'route' %}</span><span class="feature-tile__label">Access</span><span class="feature-tile__value">{{ access | default: 'N/A' }}</span></div>
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'zap' %}</span><span class="feature-tile__label">Power</span><span class="feature-tile__value">{{ power | default: 'N/A' }}</span></div>
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'droplets' %}</span><span class="feature-tile__label">Water</span><span class="feature-tile__value">{{ water | default: 'N/A' }}</span></div>
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'flask' %}</span><span class="feature-tile__label">Sewer</span><span class="feature-tile__value">{{ septic | default: 'N/A' }}</span></div>
            {%- if lat != blank and lng != blank -%}<div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'navigation' %}</span><span class="feature-tile__label">Coordinates</span><span class="feature-tile__value">{{ lat }}, {{ lng }}</span></div>{%- endif -%}
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'shield' %}</span><span class="feature-tile__label">Zoning</span><span class="feature-tile__value">{{ zoning | default: 'N/A' }}</span></div>
            <div class="feature-tile"><span class="feature-tile__icon">{% render 'icon', icon: 'mountain' %}</span><span class="feature-tile__label">Elevation</span><span class="feature-tile__value">{{ elevation | default: 'N/A' }}</span></div>
          </div>
        </div>
      {%- endif -%}

      {%- comment -%} ---- Location map ---- {%- endcomment -%}
      {%- if lat != blank and lng != blank -%}
        <div class="pdp-section">
          <h2>Location</h2>
          <div id="pdp-map" class="pdp-map" data-lat="{{ lat }}" data-lng="{{ lng }}" data-title="{{ p.title | escape }}"></div>
          <p class="text-muted pdp-map-note" style="font-size:0.8rem;margin-top:var(--space-3)">
            {% render 'icon', icon: 'map-pin' %} Parcel location: {{ lat }}, {{ lng }}
            &middot; <a href="https://www.google.com/maps/search/?api=1&query={{ lat }},{{ lng }}" target="_blank" rel="noopener">Open in Google Maps</a>
          </p>
        </div>
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="">
        <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
        <script>
          (function () {
            function num(v){ var n = parseFloat(v); return isNaN(n) ? null : n; }
            function init(){
              if (typeof L === "undefined") { return setTimeout(init, 120); }
              var el = document.getElementById("pdp-map");
              if (!el || el._built) return;
              var lat = num(el.getAttribute("data-lat")), lng = num(el.getAttribute("data-lng"));
              if (lat === null || lng === null) return;
              el._built = true;
              var map = L.map(el, { scrollWheelZoom: false }).setView([lat, lng], 13);
              L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
                maxZoom: 18,
                attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>'
              }).addTo(map);
              L.marker([lat, lng]).addTo(map).bindPopup(el.getAttribute("data-title") || "This parcel");
              setTimeout(function(){ map.invalidateSize(); }, 200);
            }
            if (document.readyState === "loading") { document.addEventListener("DOMContentLoaded", init); }
            else { init(); }
          })();
        </script>
      {%- endif -%}

      {%- comment -%} ---- Financing, explained step by step ---- {%- endcomment -%}
      {%- if monthly != blank -%}
        {%- liquid
          assign monthly_num = monthly | plus: 0
          assign down_num = down | plus: 0
          assign term_num = term | plus: 0
          assign payments_total = monthly_num | times: term_num
          assign fin_total = payments_total | plus: down_num
          assign step_pay = 2
          if down_num > 0
            assign step_pay = 3
          endif
          assign step_own = step_pay | plus: 1
        -%}
        <div class="financing-box" id="financing">
          <h2>Owner Financing, Step by Step</h2>
          <p class="fin-intro">No banks and no credit check. You make a small down payment, then equal monthly payments until it's paid off — and then the land is yours. Here's exactly how it works for this parcel:</p>

          <ol class="fin-steps">
            <li>
              <span class="fin-steps__n">1</span>
              <div class="fin-steps__body">
                <strong>Reserve it today — {{ p.price | money_without_trailing_zeros }}</strong>
                <p>A one-time document fee takes this parcel off the market so no one else can grab it. Refundable within 60 days.</p>
              </div>
            </li>
            {%- if down_num > 0 -%}
              <li>
                <span class="fin-steps__n">2</span>
                <div class="fin-steps__body">
                  <strong>Down payment — ${{ down }}</strong>
                  <p>A one-time amount paid when you sign, to start your financing.</p>
                </div>
              </li>
            {%- endif -%}
            <li>
              <span class="fin-steps__n">{{ step_pay }}</span>
              <div class="fin-steps__body">
                <strong>${{ monthly }} per month{% if term != blank %} for {{ term }} months{% endif %}</strong>
                <p>Equal, predictable monthly payments{% if settings.show_zero_interest %} at 0% interest{% endif %}. Want to finish sooner? Pay extra or pay it off anytime — no penalty.</p>
              </div>
            </li>
            <li>
              <span class="fin-steps__n">{{ step_own }}</span>
              <div class="fin-steps__body">
                <strong>The land is yours</strong>
                <p>Once it's paid in full, we transfer the deed into your name — real, recorded ownership.</p>
              </div>
            </li>
          </ol>

          <div class="fin-breakdown">
            <div class="fin-breakdown__head">The numbers at a glance</div>
            <div class="fin-breakdown__row"><span>Due today (reserves this parcel)</span><span>{{ p.price | money }}</span></div>
            {%- if down_num > 0 -%}<div class="fin-breakdown__row"><span>Down payment to start</span><span>${{ down }}</span></div>{%- endif -%}
            <div class="fin-breakdown__row"><span>Monthly payment{% if term != blank %} &times; {{ term }} months{% endif %}</span><span>${{ monthly }}{% if term != blank %}/mo{% endif %}</span></div>
            {%- if term_num > 0 and monthly_num > 0 -%}
              <div class="fin-breakdown__row fin-breakdown__row--total"><span>Total you'll pay{% if down_num > 0 %} (down + all payments){% endif %}</span><span>${{ fin_total }}</span></div>
            {%- endif -%}
            <div class="fin-breakdown__row fin-breakdown__row--alt"><span>Prefer to pay cash?</span><span>{{ cash_display }} in full</span></div>
          </div>

          <div class="fin-checks">
            {%- if settings.show_zero_interest -%}<span>{% render 'icon', icon: 'check-circle' %} 0% interest — you pay the sticker price, nothing more</span>{%- endif -%}
            <span>{% render 'icon', icon: 'check-circle' %} No credit check required</span>
            <span>{% render 'icon', icon: 'check-circle' %} No pre-payment penalty — pay off early anytime</span>
            <span>{% render 'icon', icon: 'check-circle' %} 60-day money-back guarantee</span>
          </div>
        </div>
      {%- endif -%}
    </div>

    {%- comment -%} ---------- Purchase panel ---------- {%- endcomment -%}
    <div class="pdp__aside">
      <div class="purchase-panel">
        <div class="purchase-panel__card">
          <div class="purchase-panel__head">
            <div class="lbl">Reserve This Property</div>
            <div class="ttl">{{ p.title }}</div>
            <div class="sub">{% if acres != blank %}{{ acres }} acres · {% endif %}{% if county != blank %}{{ county }} Co., {% endif %}{{ state }}</div>
          </div>
          <div class="purchase-panel__body">
            {%- if status == 'available' -%}
              {%- if monthly != blank -%}
                <p style="font-weight:600;font-size:0.9rem;margin-bottom:var(--space-3)">Choose Your Purchase Method</p>
                <div class="pay-toggle">
                  <button type="button" class="pay-option pay-option--fin is-active" data-pay="finance">
                    <div class="pay-option__name">Owner Finance</div>
                    <div class="pay-option__price">${{ monthly }}<small>/mo</small></div>
                    {%- if down != blank or term != blank -%}<div class="pay-option__sub">{% if down != blank %}${{ down }} down{% endif %}{% if down != blank and term != blank %} · {% endif %}{% if term != blank %}{{ term }} mo{% endif %}</div>{%- endif -%}
                  </button>
                  <button type="button" class="pay-option" data-pay="cash">
                    <div class="pay-option__name">Cash Purchase</div>
                    <div class="pay-option__price">{{ cash_display }}</div>
                    <div class="pay-option__sub">paid in full</div>
                  </button>
                </div>

                <div class="summary" data-summary="finance">
                  <div class="summary__row"><span class="muted">Document fee (reserves this parcel)</span><span>{{ p.price | money }}</span></div>
                  <div class="summary__total"><span>Due Today</span><span class="amt">{{ p.price | money }}</span></div>
                  <p class="summary__note">Then ${{ monthly }}/mo{% if term != blank %} for {{ term }} months{% endif %}{% if settings.show_zero_interest %} at 0% interest{% endif %}{% if down != blank %} after a ${{ down }} down payment{% endif %} — we set up your owner financing after you reserve.</p>
                </div>
                <div class="summary" data-summary="cash" hidden>
                  <div class="summary__row"><span class="muted">Document fee (reserves this parcel)</span><span>{{ p.price | money }}</span></div>
                  <div class="summary__total"><span>Due Today</span><span class="amt">{{ p.price | money }}</span></div>
                  <p class="summary__note">Balance of {{ cash_display }} due at closing.</p>
                </div>
              {%- endif -%}

              {%- form 'product', p, id: 'ReserveForm' -%}
                <input type="hidden" name="id" value="{{ p.selected_or_first_available_variant.id }}">
                <button type="submit" name="add" class="btn btn--accent btn--block btn--lg" style="margin-bottom:var(--space-2)">
                  Pay {{ p.price | money_without_trailing_zeros }} Document Fee &amp; Reserve
                </button>
              {%- endform -%}
              <p class="secure-note">🔒 Secure checkout · 60-day money-back guarantee</p>

              <div class="after-reserve">
                <p class="after-reserve__head">What happens after you reserve</p>
                <ol class="after-reserve__steps">
                  <li><span>1</span><div><strong>We lock this parcel for you.</strong> Your {{ p.price | money_without_trailing_zeros }} document fee takes it off the market so no one else can grab it.</div></li>
                  <li><span>2</span><div><strong>We reach out personally</strong> to walk you through your agreement and set up your owner financing — no credit check.</div></li>
                  <li><span>3</span><div>You receive a <strong>warranty deed in your name</strong> — real, legal ownership that's yours to keep.</div></li>
                </ol>
              </div>

              <div class="panel-contacts">
                {%- assign phone = settings.contact_phone | default: settings.phone -%}
                {%- if phone != blank -%}
                  <a href="tel:{{ phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}" class="panel-contact">{% render 'icon', icon: 'phone' %} Call {{ phone }}</a>
                {%- endif -%}
                {%- if settings.contact_email != blank -%}
                  <a href="mailto:{{ settings.contact_email }}?subject={{ p.title | url_encode }}" class="panel-contact">{% render 'icon', icon: 'mail' %} Email Us</a>
                {%- endif -%}
              </div>
            {%- else -%}
              <div class="text-center" style="padding:var(--space-5) 0">
                <p style="font-weight:700;color:var(--color-muted)">{% if status == 'sold' %}This property has been sold.{% else %}This property is under contract.{% endif %}</p>
                <p class="text-muted" style="font-size:0.9rem">Check back for similar properties, or contact us.</p>
                <a href="{{ routes.all_products_collection_url }}" class="btn btn--primary btn--block">View Other Listings</a>
              </div>
            {%- endif -%}
          </div>
        </div>

        <div class="trust-badges">
          <div class="trust-badge"><span class="emoji">🛡️</span>60-Day Guarantee</div>
          <div class="trust-badge"><span class="emoji">✅</span>No Credit Check</div>
          <div class="trust-badge"><span class="emoji">🔒</span>Secure Process</div>
        </div>
      </div>
    </div>
  </div>
</div>

{%- comment -%} Zoom lightbox {%- endcomment -%}
<div class="lightbox" id="Lightbox" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
  <button type="button" class="lightbox__close" data-lb-close aria-label="Close">{% render 'icon', icon: 'close' %}</button>
  <button type="button" class="lightbox__nav lightbox__prev" data-lb-prev aria-label="Previous photo">{% render 'icon', icon: 'arrow-left' %}</button>
  <img class="lightbox__img" data-lb-img alt="{{ p.title | escape }}">
  <button type="button" class="lightbox__nav lightbox__next" data-lb-next aria-label="Next photo">{% render 'icon', icon: 'arrow-right' %}</button>
  <div class="lightbox__count" data-lb-count></div>
</div>

{%- comment -%} Product gallery: swap the main image, plus click-to-zoom lightbox {%- endcomment -%}
<script>
  (function () {
    var g = document.querySelector('[data-gallery]');
    if (!g) return;
    var mainImg = g.querySelector('[data-gallery-main] img');
    var thumbs = Array.prototype.slice.call(g.querySelectorAll('[data-gallery-thumb]'));

    // Build the ordered list of full-size image URLs.
    var images = thumbs.length
      ? thumbs.map(function (t) { return t.getAttribute('data-full'); })
      : (mainImg ? [mainImg.src] : []);
    var current = 0;

    // Thumbnail click swaps the main image.
    thumbs.forEach(function (thumb, i) {
      thumb.addEventListener('click', function () {
        var full = thumb.getAttribute('data-full');
        var alt = thumb.getAttribute('data-alt') || '';
        if (full && mainImg) {
          mainImg.removeAttribute('srcset'); mainImg.removeAttribute('sizes'); mainImg.removeAttribute('loading');
          mainImg.src = full; mainImg.alt = alt;
        }
        current = i;
        thumbs.forEach(function (t) { t.setAttribute('aria-current', t === thumb ? 'true' : 'false'); });
      });
    });

    // Lightbox
    var lb = document.getElementById('Lightbox');
    if (!lb || !images.length) return;
    var lbImg = lb.querySelector('[data-lb-img]');
    var lbCount = lb.querySelector('[data-lb-count]');
    var multi = images.length > 1;

    function render() {
      lbImg.src = images[current];
      if (lbCount) lbCount.textContent = multi ? (current + 1) + ' / ' + images.length : '';
      lb.querySelectorAll('.lightbox__nav').forEach(function (n) { n.hidden = !multi; });
    }
    function open(i) {
      current = typeof i === 'number' ? i : current;
      render();
      lb.hidden = false;
      requestAnimationFrame(function () { lb.classList.add('is-open'); });
      document.body.style.overflow = 'hidden';
    }
    function close() {
      lb.classList.remove('is-open');
      document.body.style.overflow = '';
      setTimeout(function () { lb.hidden = true; }, 200);
    }
    function step(d) { current = (current + d + images.length) % images.length; render(); }

    var opener = g.querySelector('[data-zoom-open]');
    if (opener) {
      opener.addEventListener('click', function () {
        // open at whichever image is currently showing
        var active = thumbs.findIndex(function (t) { return t.getAttribute('aria-current') === 'true'; });
        open(active > -1 ? active : 0);
      });
      opener.addEventListener('keydown', function (e) {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); open(); }
      });
    }
    lb.querySelector('[data-lb-close]').addEventListener('click', close);
    lb.querySelector('[data-lb-prev]').addEventListener('click', function () { step(-1); });
    lb.querySelector('[data-lb-next]').addEventListener('click', function () { step(1); });
    lb.addEventListener('click', function (e) { if (e.target === lb) close(); });
    document.addEventListener('keydown', function (e) {
      if (lb.hidden) return;
      if (e.key === 'Escape') close();
      else if (e.key === 'ArrowLeft' && multi) step(-1);
      else if (e.key === 'ArrowRight' && multi) step(1);
    });
  })();
</script>

{%- comment -%} Share {%- endcomment -%}
<script>
  (function () {
    var wrap = document.querySelector('[data-share]');
    if (!wrap) return;
    var btn = wrap.querySelector('[data-share-btn]');
    var menu = wrap.querySelector('[data-share-menu]');
    var copyBtn = wrap.querySelector('[data-share-copy]');
    var shareData = { title: {{ p.title | json }}, url: window.location.href };

    function closeMenu() { menu.hidden = true; btn.setAttribute('aria-expanded', 'false'); }
    function toggleMenu() {
      var open = menu.hidden;
      menu.hidden = !open;
      btn.setAttribute('aria-expanded', open ? 'true' : 'false');
    }

    btn.addEventListener('click', function (e) {
      e.stopPropagation();
      if (navigator.share) {
        navigator.share(shareData).catch(function () {});
      } else {
        toggleMenu();
      }
    });

    if (copyBtn) {
      copyBtn.addEventListener('click', function () {
        var done = function () {
          var lbl = copyBtn.querySelector('[data-copy-label]');
          if (lbl) { var t = lbl.textContent; lbl.textContent = 'Link copied!'; setTimeout(function () { lbl.textContent = t; closeMenu(); }, 1200); }
        };
        if (navigator.clipboard) navigator.clipboard.writeText(window.location.href).then(done, done);
        else done();
      });
    }

    document.addEventListener('click', function (e) { if (!wrap.contains(e.target)) closeMenu(); });
  })();
</script>

{%- comment -%} Payment method toggle {%- endcomment -%}
<script>
  (function () {
    var opts = document.querySelectorAll('[data-pay]');
    var summaries = document.querySelectorAll('[data-summary]');
    opts.forEach(function (opt) {
      opt.addEventListener('click', function () {
        var type = opt.getAttribute('data-pay');
        opts.forEach(function (o) { o.classList.toggle('is-active', o === opt); });
        summaries.forEach(function (s) { s.hidden = s.getAttribute('data-summary') !== type; });
      });
    });
  })();
</script>

