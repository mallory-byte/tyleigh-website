{%- comment -%} sync: rev2 {%- endcomment -%}
<section id="how-it-works" class="hiw section">
  <div class="page-width">
    <div class="section-head">
      {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
      <h2>{{ section.settings.heading }}</h2>
      {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    </div>

    <div class="hiw__steps">
      <div class="hiw__line"></div>
      {%- for block in section.blocks -%}
        <div class="hiw-step" {{ block.shopify_attributes }}>
          <div class="hiw-step__icon">
            {% render 'icon', icon: block.settings.icon %}
            <span class="hiw-step__num">{{ forloop.index }}</span>
          </div>
          <h3>{{ block.settings.title }}</h3>
          <p>{{ block.settings.text }}</p>
        </div>
      {%- endfor -%}
    </div>

    {%- if section.settings.guarantee_title != blank -%}
      <div class="guarantee-bar">
        <h3>🛡️ {{ section.settings.guarantee_title }}</h3>
        <p>{{ section.settings.guarantee_text }}</p>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "How it works",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Simple Process" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "How It Works" },
    { "type": "textarea", "id": "subtext", "label": "Subtext", "default": "Own land in 4 easy steps — faster than you think." },
    { "type": "text", "id": "guarantee_title", "label": "Guarantee title", "default": "Our 60-Day Money-Back Guarantee" },
    { "type": "textarea", "id": "guarantee_text", "label": "Guarantee text", "default": "If you're not happy with your purchase for any reason within 60 days, we'll refund every payment you've made toward the land. The one-time document fee is non-refundable. No questions asked on the rest — that's our promise to you." }
  ],
  "blocks": [
    {
      "type": "step",
      "name": "Step",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "default": "search",
          "options": [
            { "value": "search", "label": "Search" },
            { "value": "file-check", "label": "Document" },
            { "value": "credit-card", "label": "Credit card" },
            { "value": "key", "label": "Key" },
            { "value": "map-pin", "label": "Map pin" },
            { "value": "shield", "label": "Shield" }
          ]
        },
        { "type": "text", "id": "title", "label": "Title", "default": "Browse & Find" },
        { "type": "textarea", "id": "text", "label": "Text", "default": "Explore our listings on the map or grid. Filter by state, price, or acreage to find your perfect land." }
      ]
    }
  ],
  "max_blocks": 4,
  "presets": [
    {
      "name": "How it works",
      "blocks": [
        { "type": "step", "settings": { "icon": "search", "title": "Browse & Find", "text": "Explore our listings on the map or grid. Filter by state, price, or acreage to find your perfect land." } },
        { "type": "step", "settings": { "icon": "file-check", "title": "Reserve It", "text": "Call or text us at (662) 442-4362. No credit check required. We hold your property with a simple down payment." } },
        { "type": "step", "settings": { "icon": "credit-card", "title": "Sign & Finance", "text": "Sign the land contract online. Choose owner financing starting as low as $89/month — no bank needed." } },
        { "type": "step", "settings": { "icon": "key", "title": "Own Your Land", "text": "Once paid in full, we transfer the deed to your name. Start building your legacy from day one." } }
      ]
    }
  ]
}
{% endschema %}
