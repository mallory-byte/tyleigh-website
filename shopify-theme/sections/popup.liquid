{%- liquid
  assign s = section.settings
  assign delay = s.delay_seconds | default: 4
  assign days = s.frequency_days | default: 7
  assign fcol = collections.all
  if s.finder_collection != blank
    assign fcol = s.finder_collection
  endif
  assign fapi = settings.finder_api_url
-%}
{%- if s.enabled -%}
  <div class="popup{% if s.mode == 'finder' %} popup--finder{% endif %}" id="site-popup" role="dialog" aria-modal="true" aria-labelledby="popup-title"
       data-delay="{{ delay }}" data-days="{{ days }}"{% if form.posted_successfully? %} data-force-open="true"{% endif %} hidden>
    <div class="popup__overlay" data-popup-close></div>
    <div class="popup__panel">
      <button type="button" class="popup__close" data-popup-close aria-label="Close">{% render 'icon', icon: 'close' %}</button>

      {%- if s.mode == 'finder' -%}
        {%- comment -%} The Property Finder quiz, popped up. {%- endcomment -%}
        <div class="popup__finder">
          {% render 'finder-quiz',
             uid: 'popup',
             col: fcol,
             api: fapi,
             eyebrow: s.eyebrow,
             heading: s.heading,
             subheading: s.text,
             cta_label: s.finder_cta %}
        </div>

      {%- else -%}
        {%- if s.image != blank -%}
          <img class="popup__img" src="{{ s.image | image_url: width: 900 }}" alt="" loading="lazy">
        {%- endif -%}
        <div class="popup__body">
          {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
          <h2 id="popup-title">{{ s.heading }}</h2>
          {%- if s.text != blank -%}<p class="popup__text">{{ s.text }}</p>{%- endif -%}

          {%- if s.mode == 'email' -%}
            {%- form 'customer', id: 'PopupForm' -%}
              <input type="hidden" name="contact[tags]" value="{{ s.tag }}">
              {%- if form.posted_successfully? -%}
                <div class="popup__success">{% render 'icon', icon: 'check-circle' %} {{ s.success_text }}</div>
              {%- else -%}
                <div class="popup__form">
                  <label class="search-form__field">
                    <span class="visually-hidden">Email address</span>
                    {% render 'icon', icon: 'mail' %}
                    <input type="email" name="contact[email]" placeholder="{{ s.email_placeholder | default: 'you@email.com' }}" required>
                  </label>
                  <button type="submit" class="btn btn--accent btn--block">{{ s.email_button | default: 'Notify Me' }}</button>
                </div>
              {%- endif -%}
            {%- endform -%}
          {%- elsif s.button_label != blank -%}
            <a href="{{ s.button_link | default: '#' }}" class="btn btn--accent btn--block">{{ s.button_label }}</a>
          {%- endif -%}

          {%- if s.fineprint != blank -%}<p class="popup__fine">{{ s.fineprint }}</p>{%- endif -%}
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- if s.mode == 'finder' -%}
    <style>
      .popup--finder .popup__panel { max-width: 640px; width: 100%; max-height: 92vh; overflow-y: auto; padding: 28px 24px 24px; }
      .popup--finder .popup__finder .finder,
      .popup--finder .popup__finder .finder__inner { margin: 0; padding: 0; max-width: 100%; }
      .popup--finder .popup__finder .finder__h1 { font-size: 1.6rem; margin-top: 4px; }
      .popup--finder .popup__finder .finder-benefits { text-align: left; }
    </style>
  {%- endif -%}

  <script>
    (function () {
      var el = document.getElementById("site-popup");
      if (!el) return;
      // Don't pop the finder on a page that already shows the finder section.
      if (el.classList.contains("popup--finder") && document.querySelector("[data-finder-page]")) return;
      var days = parseInt(el.getAttribute("data-days"), 10) || 7;
      var delay = (parseInt(el.getAttribute("data-delay"), 10) || 4) * 1000;
      var KEY = "tyl_popup_seen";
      function seen() {
        try { var t = localStorage.getItem(KEY); return t && (Date.now() - parseInt(t, 10) < days * 86400000); }
        catch (e) { return false; }
      }
      function mark() { try { localStorage.setItem(KEY, Date.now().toString()); } catch (e) {} }
      function open() {
        el.hidden = false;
        requestAnimationFrame(function () { el.classList.add("is-open"); });
        document.body.style.overflow = "hidden";
        mark();
      }
      function close() {
        el.classList.remove("is-open");
        document.body.style.overflow = "";
        setTimeout(function () { el.hidden = true; }, 250);
      }
      el.querySelectorAll("[data-popup-close]").forEach(function (b) { b.addEventListener("click", close); });
      document.addEventListener("keydown", function (e) { if (e.key === "Escape" && !el.hidden) close(); });

      if (el.getAttribute("data-force-open") === "true") { open(); return; }
      if (seen()) return;
      setTimeout(open, delay);
    })();
  </script>
{%- endif -%}

{% schema %}
{
  "name": "Popup",
  "settings": [
    { "type": "checkbox", "id": "enabled", "label": "Enable popup", "default": true },
    {
      "type": "select", "id": "mode", "label": "What the popup shows", "default": "finder",
      "options": [
        { "value": "finder", "label": "Property Finder quiz" },
        { "value": "email", "label": "Email capture" },
        { "value": "button", "label": "Message + button" }
      ]
    },
    { "type": "range", "id": "delay_seconds", "min": 0, "max": 20, "step": 1, "unit": "s", "label": "Show after", "default": 4 },
    { "type": "range", "id": "frequency_days", "min": 1, "max": 30, "step": 1, "unit": "d", "label": "Don't show again for", "default": 7 },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find Your Land" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See every property you can afford" },
    { "type": "textarea", "id": "text", "label": "Text", "default": "Answer 3 quick questions and we'll show you every owner-financed parcel that fits your monthly budget." },
    { "type": "header", "content": "Property Finder mode" },
    { "type": "collection", "id": "finder_collection", "label": "Listings collection", "info": "Which products the popup finder matches against. Leave blank for all." },
    { "type": "text", "id": "finder_cta", "label": "Start button label", "default": "Find My Land →" },
    { "type": "paragraph", "content": "The finder emails matches automatically using the endpoint set under Theme settings → Property Finder." },
    { "type": "header", "content": "Email capture mode" },
    { "type": "image_picker", "id": "image", "label": "Image (optional)" },
    { "type": "text", "id": "email_placeholder", "label": "Email placeholder", "default": "you@email.com" },
    { "type": "text", "id": "email_button", "label": "Button label", "default": "Notify Me" },
    { "type": "text", "id": "success_text", "label": "Success message", "default": "You're on the list! We'll email you when new land drops." },
    { "type": "text", "id": "tag", "label": "Tag added to signups", "default": "land-alerts, popup" },
    { "type": "header", "content": "Message + button mode" },
    { "type": "text", "id": "button_label", "label": "Button label" },
    { "type": "url", "id": "button_link", "label": "Button link" },
    { "type": "header", "content": "Fine print" },
    { "type": "text", "id": "fineprint", "label": "Fine print", "default": "No spam. Unsubscribe anytime." }
  ]
}
{% endschema %}
