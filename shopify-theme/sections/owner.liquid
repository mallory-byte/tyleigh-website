{%- liquid
  assign s = section.settings
-%}
{%- liquid
  assign has_video = false
  if s.video != blank or s.video_url != blank
    assign has_video = true
  endif
  assign has_media = false
  if s.image != blank or has_video
    assign has_media = true
  endif
-%}
<div class="page-width section" id="meet-the-owner">
  <div class="owner {% unless has_media %}owner--no-image{% endunless %}">
    {%- if has_media -%}
      <div class="owner__media {% if has_video %}owner__media--video{% endif %}">
        {%- if s.video != blank -%}
          {{ s.video | video_tag: controls: true, playsinline: true, preload: 'metadata', image_size: '900x' }}
        {%- elsif s.video_url != blank -%}
          {{ s.video_url | external_video_tag }}
        {%- else -%}
          <img src="{{ s.image | image_url: width: 900 }}" alt="{{ s.name | escape }}" width="900" height="1100" loading="lazy">
        {%- endif -%}
        {%- if s.badge != blank and has_video == false -%}<span class="owner__badge">{% render 'icon', icon: 'shield' %} {{ s.badge }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="owner__body">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.story != blank -%}<div class="owner__story rte">{{ s.story }}</div>{%- endif -%}

      {%- if s.name != blank -%}
        <div class="owner__sign">
          {%- if s.signature != blank -%}<span class="owner__signature">{{ s.signature }}</span>{%- endif -%}
          <span class="owner__name">{{ s.name }}</span>
          {%- if s.role != blank -%}<span class="owner__role">{{ s.role }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_trust -%}
        <div class="owner__trust">
          {%- if s.trust_1 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_1 }}</span>{%- endif -%}
          {%- if s.trust_2 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_2 }}</span>{%- endif -%}
          {%- if s.trust_3 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_3 }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#' }}" class="btn btn--primary">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meet the owner",
  "settings": [
    { "type": "header", "content": "Intro video (recommended)" },
    { "type": "paragraph", "content": "A short 30–60 sec “Hi, I'm Mallory” video is the single biggest trust-builder — it's the thing scammy sellers can't fake. Upload one below, or paste a YouTube/Vimeo link. If both are empty, your photo shows instead." },
    { "type": "video", "id": "video", "label": "Upload intro video" },
    { "type": "video_url", "id": "video_url", "label": "…or YouTube / Vimeo link", "accept": ["youtube", "vimeo"] },
    { "type": "image_picker", "id": "image", "label": "Your photo", "info": "Shown when no video is set. A real, friendly photo of you builds the most trust. Portrait orientation works best." },
    { "type": "text", "id": "badge", "label": "Photo badge (optional)", "default": "" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The person behind Ty-Leigh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hi — I'm the one you'll actually talk to." },
    { "type": "richtext", "id": "story", "label": "Your story", "default": "<p>I co-own Ty-Leigh Capital and run it day to day — which means when you have a question, you're talking to me. Not a call center, not a bot. A real person who knows every parcel we sell.</p><p>Every lot is real, recorded land with a clear deed and honest owner financing — no credit check, no games. When you reserve, I'll personally walk you through each step and make sure you close with confidence and a warranty deed in your name.</p>" },
    { "type": "text", "id": "signature", "label": "Signature line", "default": "— Talk soon," },
    { "type": "text", "id": "name", "label": "Your name", "default": "Mallory" },
    { "type": "text", "id": "role", "label": "Your role/title", "default": "Co-Owner · Runs Ty-Leigh Capital day to day" },
    { "type": "header", "content": "Trust points" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust points", "default": true },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "A real warranty deed in your name" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "Use a title company if you want — we'll work with you" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "60-day money-back guarantee" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Talk to me directly" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Meet the owner" } ]
}
{% endschema %}
