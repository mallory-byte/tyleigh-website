{%- liquid
  assign s = section.settings
-%}
<div class="page-width section">
  <div class="owner {% if s.image == blank %}owner--no-image{% endif %}">
    {%- if s.image != blank -%}
      <div class="owner__media">
        <img src="{{ s.image | image_url: width: 900 }}" alt="{{ s.name | escape }}" width="900" height="1100" loading="lazy">
        {%- if s.badge != blank -%}<span class="owner__badge">{% render 'icon', icon: 'shield' %} {{ s.badge }}</span>{%- endif -%}
      </div>
    {%- endif -%}
    <div class="owner__body">
      {%- if s.eyebrow != blank -%}<span class="eyebrow">{{ s.eyebrow }}</span>{%- endif -%}
      {%- if s.heading != blank -%}<h2>{{ s.heading }}</h2>{%- endif -%}
      {%- if s.story != blank -%}<div class="owner__story rte">{{ s.story }}</div>{%- endif -%}

      {%- if s.name != blank -%}
        <div class="owner__sign">
          {%- if s.signature != blank -%}<span class="owner__signature">{{ s.signature }}</span>{%- endif -%}
          <span class="owner__name">{{ s.name }}</span>
          {%- if s.role != blank -%}<span class="owner__role">{{ s.role }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.show_trust -%}
        <div class="owner__trust">
          {%- if s.trust_1 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_1 }}</span>{%- endif -%}
          {%- if s.trust_2 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_2 }}</span>{%- endif -%}
          {%- if s.trust_3 != blank -%}<span>{% render 'icon', icon: 'check-circle' %} {{ s.trust_3 }}</span>{%- endif -%}
        </div>
      {%- endif -%}

      {%- if s.button_label != blank -%}
        <a href="{{ s.button_link | default: '#' }}" class="btn btn--primary">{{ s.button_label }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Meet the owner",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Your photo", "info": "A real, friendly photo of you builds the most trust. Portrait orientation works best." },
    { "type": "text", "id": "badge", "label": "Photo badge (optional)", "default": "Licensed Land Dealer" },
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "The person behind Ty-Leigh" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Hi, I'm the owner — and this is real." },
    { "type": "richtext", "id": "story", "label": "Your story", "default": "<p>I started Ty-Leigh Capital because I believe owning land shouldn't require perfect credit or a bank's permission. Every parcel I sell is one I'd buy myself — real, recorded land with a clear deed and honest owner financing.</p><p>When you reserve, you're not talking to a call center. You're talking to me. I'll walk you through every step, answer every question, and make sure you close with confidence and a warranty deed in your name.</p>" },
    { "type": "text", "id": "signature", "label": "Signature line", "default": "— Warmly," },
    { "type": "text", "id": "name", "label": "Your name", "default": "Mallory" },
    { "type": "text", "id": "role", "label": "Your role/title", "default": "Founder, Ty-Leigh Capital Land Co." },
    { "type": "header", "content": "Trust points" },
    { "type": "checkbox", "id": "show_trust", "label": "Show trust points", "default": true },
    { "type": "text", "id": "trust_1", "label": "Trust point 1", "default": "Every deed recorded with the county" },
    { "type": "text", "id": "trust_2", "label": "Trust point 2", "default": "Closings through a licensed title company" },
    { "type": "text", "id": "trust_3", "label": "Trust point 3", "default": "60-day money-back guarantee" },
    { "type": "header", "content": "Button" },
    { "type": "text", "id": "button_label", "label": "Button label", "default": "Talk to me directly" },
    { "type": "url", "id": "button_link", "label": "Button link" }
  ],
  "presets": [ { "name": "Meet the owner" } ]
}
{% endschema %}
