{%- liquid
  assign col = collections.all
  if section.settings.collection != blank
    assign col = section.settings.collection
  endif
  assign api = section.settings.finder_api_url
  if api == blank
    assign api = settings.finder_api_url
  endif
-%}
<div class="finder-section" data-finder-page>
  {% render 'finder-quiz',
     uid: 'page',
     col: col,
     api: api,
     eyebrow: section.settings.eyebrow,
     heading: section.settings.heading,
     subheading: section.settings.subheading,
     cta_label: section.settings.cta_label %}
</div>

{% schema %}
{
  "name": "Property finder",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Find Your Land" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "See Every Property You Can Afford" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Find land based on your monthly budget—not just the purchase price." },
    { "type": "text", "id": "cta_label", "label": "Start button label", "default": "Find My Land →" },
    { "type": "collection", "id": "collection", "label": "Listings collection", "info": "Which products to match against. Leave blank for all products. Only listings with a monthly payment are included." },
    { "type": "header", "content": "Automated email (optional)" },
    { "type": "text", "id": "finder_api_url", "label": "Finder API endpoint", "info": "Overrides the site-wide endpoint set under Theme settings → Property Finder. Leave blank to use that one." }
  ],
  "presets": [ { "name": "Property finder" } ]
}
{% endschema %}
