<div class="page-width section">
  <div class="section-head">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h2>{{ section.settings.heading }}</h2>
  </div>
  <div class="card-grid">
    {%- for block in section.blocks -%}
      <figure class="prose-card" style="margin-bottom:0" {{ block.shopify_attributes }}>
        <blockquote style="font-size:1.05rem;margin:0 0 var(--space-4)">"{{ block.settings.quote }}"</blockquote>
        <figcaption>
          <div style="font-weight:700;color:var(--color-text)">{{ block.settings.author }}</div>
          {%- if block.settings.detail != blank -%}<div class="text-muted" style="font-size:0.88rem">{{ block.settings.detail }}</div>{%- endif -%}
        </figcaption>
      </figure>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Testimonials",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow", "default": "Buyers" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Land owners who started here" }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        { "type": "textarea", "id": "quote", "label": "Quote", "default": "The whole process was transparent and quick. I had the deed to my land in a few weeks." },
        { "type": "text", "id": "author", "label": "Author", "default": "Dana R." },
        { "type": "text", "id": "detail", "label": "Detail", "default": "Costilla County, CO" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [
    { "name": "Testimonials", "blocks": [ { "type": "quote" }, { "type": "quote" }, { "type": "quote" } ] }
  ]
}
{% endschema %}
