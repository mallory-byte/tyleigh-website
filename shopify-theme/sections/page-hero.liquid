<section class="page-hero">
  <div class="page-width">
    {%- if section.settings.eyebrow != blank -%}<span class="eyebrow">{{ section.settings.eyebrow }}</span>{%- endif -%}
    <h1>{{ section.settings.heading | default: page.title }}</h1>
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Page hero",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Eyebrow" },
    { "type": "text", "id": "heading", "label": "Heading (defaults to page title)" },
    { "type": "textarea", "id": "subtext", "label": "Subtext" }
  ],
  "presets": [ { "name": "Page hero" } ]
}
{% endschema %}
