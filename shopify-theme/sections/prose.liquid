<div class="page-width section--sm">
  <div class="prose">
    {%- if section.settings.intro != blank -%}
      <div class="prose-card"><div class="rte" style="font-size:1.05rem">{{ section.settings.intro }}</div></div>
    {%- endif -%}

    {%- for block in section.blocks -%}
      <div class="prose-card" {{ block.shopify_attributes }}>
        {%- if block.settings.heading != blank -%}
          <h2>
            {%- if block.settings.icon != blank and block.settings.icon != 'none' -%}<span class="prose-card__icon">{% render 'icon', icon: block.settings.icon %}</span>{%- endif -%}
            {{ block.settings.heading }}
          </h2>
        {%- endif -%}
        <div class="rte text-muted">{{ block.settings.text }}</div>
        {%- if block.settings.button_label != blank -%}
          <a href="{{ block.settings.button_link }}" class="btn btn--outline btn--pill" style="margin-top:var(--space-2)">{{ block.settings.button_label }}</a>
        {%- endif -%}
      </div>
    {%- endfor -%}
  </div>
</div>

{% schema %}
{
  "name": "Prose content",
  "settings": [
    { "type": "richtext", "id": "intro", "label": "Intro text" }
  ],
  "blocks": [
    {
      "type": "card",
      "name": "Content card",
      "settings": [
        {
          "type": "select", "id": "icon", "label": "Icon", "default": "none",
          "options": [
            { "value": "none", "label": "None" },
            { "value": "file-check", "label": "Document" },
            { "value": "file-text", "label": "File" },
            { "value": "doc", "label": "Doc" },
            { "value": "shield", "label": "Shield" },
            { "value": "credit-card", "label": "Credit card" },
            { "value": "dollar", "label": "Dollar" },
            { "value": "gift", "label": "Gift" },
            { "value": "users", "label": "Users" }
          ]
        },
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "richtext", "id": "text", "label": "Text", "default": "<p>Add your content here.</p>" },
        { "type": "text", "id": "button_label", "label": "Button label" },
        { "type": "url", "id": "button_link", "label": "Button link" }
      ]
    }
  ],
  "max_blocks": 12,
  "presets": [ { "name": "Prose content" } ]
}
{% endschema %}
